# Keep the build context small: no build output, dependencies, local state or git history.
target/
**/node_modules/
harness/dist/
state/
.git/
.claude/
# Every settings file with secrets (deploy/.env, deploy/live.env, …); the examples stay.
deploy/*.env
deploy/.env
!deploy/env.example
!deploy/live.env.example
deploy/backups/
