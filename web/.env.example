# The dev server uses the sample-data client by default, so nothing needs setting for `pnpm dev`.
# To talk to a real pmos-web instead of the sample data:
# VITE_API=real
#
# Never set VITE_API=mock for a build. `pnpm build` fails when it is set, so the sample-data
# client cannot ship by accident.

# Dev server only, sample data switches:
# VITE_MOCK_BRIEF=off      # GET /api/brief answers 501 not_built
# VITE_MOCK_HOSTILE=on     # add a draft that tries style, hidden text, a form and a remote image
# VITE_MOCK_FAST=on        # no pretend network delay (used by the browser tests)

# dev (handle field) or entra (later)
VITE_AUTH_PROVIDER=dev
