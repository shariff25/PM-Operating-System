# PM OS live connectors: deploy/live.env, read only by the tool server. Copy this file, fill it
# in at Gate 1, and set PMOS_CONNECTORS=live in deploy/.env. Never commit it.
# Delete the lines you don't use: an empty value is not the same as leaving a setting out.
# Every variable is described in docs/toolserver.md (Configuration).

# Where PMs' browsers reach the tool server's OAuth callback (through the reverse proxy).
PMOS_PUBLIC_URL=https://pmos.example.internal

# Atlassian OAuth 2.0 (3LO) app.
PMOS_ATLASSIAN_CLIENT_ID=
PMOS_ATLASSIAN_CLIENT_SECRET=
# Only if the grant covers several Atlassian sites.
PMOS_ATLASSIAN_SITE=

# The Slack app's OAuth client (user tokens, so drafts post as the PM).
PMOS_SLACK_CLIENT_ID=
PMOS_SLACK_CLIENT_SECRET=

# GitHub App (docs/toolserver.md, GitHub App setup): account linking, memory and onboarding,
# and admin proposals, opened as the proposing admin (docs/policy-admin.md). With
# PMOS_CONTENT_REPO, proposals are on (PMOS_PROPOSALS=off turns them off; PMOS_PROPOSALS_PER_HOUR,
# default 10, limits each admin).
PMOS_GITHUB_CLIENT_ID=
PMOS_GITHUB_CLIENT_SECRET=
PMOS_GITHUB_ORG=
PMOS_CONTENT_REPO=
PMOS_MEMORY=github
