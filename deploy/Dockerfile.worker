# syntax=docker/dockerfile:1
# The harness worker: the image each bot's OpenShell sandbox runs (docs/sandbox-policies.md).
# Node is at /usr/local/bin/node, the path the sandbox policies allow.

FROM node:22-bookworm-slim AS build
ARG HTTPS_PROXY
ARG NO_PROXY
WORKDIR /src
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY harness/package.json harness/
RUN --mount=type=secret,id=ca,required=false \
    if [ -s /run/secrets/ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/ca; fi \
 && npm_config_https_proxy="$HTTPS_PROXY" npm install -g pnpm@10.28.0 \
 && pnpm config set https-proxy "${HTTPS_PROXY:-}" \
 && pnpm install --frozen-lockfile
COPY harness/ harness/
RUN pnpm -C harness build

FROM node:22-bookworm-slim
# The workload's identity (slice H0, docs/openshell-any-host-spec.md §3.7):
# - OpenShell's sandbox page says a Docker target "must declare an explicit numeric
#   `USER UID:GID`" and that "symbolic or implicit identities are rejected"
#   (how-it-works/sandboxes/overview.mdx; said there for sandbox updates). So the image ends
#   with a numeric USER, not a name.
# - Every generated policy asks for `run_as_user: sandbox` and `run_as_group: sandbox`
#   (crates/policy/src/lib.rs, RUN_AS), an account the node image doesn't have; this adds it,
#   with fixed ids at or above the policy check's minimum of 1000 (MIN_NUMERIC_ID), and apart
#   from the image's own `node` (1000) and the services' default 10001.
# Verify on a real host (RT-3 and O-CANARY in the acceptance run): whether OpenShell runs the
# workload as the image's USER, as the policy's run_as_user, or creates the account itself.
# Slice H5 changes this if it differs.
#
# /opt/pmos stays root's and read-only to the worker (it was copied as root and is world-readable,
# as it was for `node`); only the workspace, the worker's working directory, is the account's.
# The eval stack and the bring-up worker run this image as plain containers with the content
# mounted read-only, with `user:` set to the checkout's owner (PMOS_UID:PMOS_GID, as the
# services), not 10100: 10100 can't read a checkout that isn't world-readable (made with umask
# 077), where `node` (1000) could when the operator was uid 1000. The harness writes only under
# the system temporary directory (harness/src/worker.ts, agent.ts: os.tmpdir()), so any uid
# works there.
RUN groupadd --gid 10100 sandbox \
 && useradd --uid 10100 --gid 10100 --no-log-init --create-home --home-dir /home/sandbox \
      --shell /bin/bash sandbox \
 && mkdir -p /sandbox/workspace \
 && chown 10100:10100 /sandbox/workspace
COPY --from=build /src /opt/pmos
# The sandbox uploads the bot's skills, master context and tools.yaml under /sandbox.
ENV PMOS_CONTENT_ROOT=/sandbox NODE_ENV=production
WORKDIR /sandbox/workspace
USER 10100:10100
CMD ["/usr/local/bin/node", "/opt/pmos/harness/dist/main.js"]
