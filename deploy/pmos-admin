    # the values read at the top would hide the new tokens.
    load_env
    compose up -d bots gateway
    say "tokens added for $bot; the runtime and gateway were restarted with them."
    say "next: deploy/pmos-admin sandbox $bot"
    ;;

  sandbox)
    # What each step rests on (slice H0; docs/openshell-any-host-spec.md §3.7). Nothing here
    # has run on a real OpenShell yet; the acceptance run (§6) checks each "verify" below.
    # - `sandbox create --from <image>`: OpenShell's sandbox page documents `--from` with "an
    #   explicit OCI image reference" built and tagged "with the container engine used by your
    #   local gateway" (the earlier `--image` isn't documented). Verify on a real host: that it
    #   takes the local tag pmos-worker:<version> without a registry.
    # - The worker runs as the systemd user unit deploy/systemd/pmos-worker@.service (no more
    #   `&` from the operator's shell, which died at logout and never came back after a reboot).
    #   Verify on a real host: that `sandbox exec` stays in the foreground for the worker's life,
    #   and the name of OpenShell's gateway unit (see the unit file).
    # - `--policy`, `--provider` and `--upload`: as in docs/sandbox-policies.md.
    # - The providers (provider_upsert): OpenShell's providers page (how-it-works/providers/
    #   overview.mdx, read 2026-11-22) makes providers their own resources, attached to
    #   sandboxes and deleted separately ("first detach the providers from any sandboxes that
    #   still use them. Then delete the providers"), and documents `provider get <name>` and
    #   `provider update <name> --credential <VAR>` (it replaces the credential, and attached
    #   sandboxes apply it for new processes). So a provider survives `sandbox delete`, and
    #   creating it again would collide: an existing one is updated with the token from
    #   deploy/.env instead, which is also how a rotated token reaches it (docs/runbooks/
    #   incidents.md). `--credential <VAR>` without a value reads the token from the
    #   environment, never the command line (the same page: a value there is in "the host
    #   process table"). Verify on a real host: that `provider get` exits non-zero only for a
    #   provider that doesn't exist, and that `provider create` refuses an existing name.
    sandbox_usage() { say "usage: pmos-admin sandbox <bot> [--dry-run]" >&2; exit 2; }
    dry=0
    names=()
    for a in "$@"; do
      case "$a" in
        --dry-run) dry=1 ;;
        -*) sandbox_usage ;;
        *) names+=("$a") ;;
      esac
    done
    [ ${#names[@]} -eq 1 ] || sandbox_usage
    bot=${names[0]}
    require_bot_name sandbox "$bot"
    # Slice H2 (docs/openshell-any-host-spec.md §3.3): no sandbox starts while the three names
    # don't resolve on this host to their pinned addresses (a missing, stale or loopback entry,
    # or the red team's temporary line, RT-13b), with --dry-run too, which shows what would run.
    if ! problems=$(host_names_problems); then
      {
        say "pmos-admin sandbox: the service names fail their check, so the sandbox couldn't reach"
        say "the services by them, or would reach something else:"
        sed 's/^/  /' <<<"$problems"
        say "Fix it, then run this again: sudo deploy/pmos-admin host-names apply"
      } >&2
      exit 2
    fi
    # Fake-data mode (slice H4): nothing is uploaded from a checkout that isn't test content,
    # with --dry-run too.
    if [ "${PMOS_MODEL_SOURCE:-}" = hosted-test ] && ! problems=$(test_content_problems); then
      {
        say "pmos-admin sandbox: PMOS_MODEL_SOURCE=hosted-test allows fake data only, and the content checkout isn't test content, so nothing is uploaded:"
        sed 's/^/  /' <<<"$problems"
      } >&2
      exit 2
    fi
    # And the same check in the image (`pmos content check-test`, slice H4), as the services
    # run it, before anything is created.
    if [ "${PMOS_MODEL_SOURCE:-}" = hosted-test ] && [ "$dry" != 1 ]; then
      pmos_cli pmos content check-test --root content >&2 || {
        say "pmos-admin sandbox: the content check refused the checkout (above); nothing was uploaded" >&2
        exit 2
      }
    fi
    [ "$dry" = 1 ] || command -v openshell >/dev/null || { say "openshell is not installed" >&2; exit 1; }
    # The host preflight with the OpenShell checks, two canary sandboxes included (slice H1).
    # --dry-run creates nothing, so it runs the host checks only.
    if [ "$dry" = 1 ]; then run_preflight sandbox --stage run; else run_preflight sandbox --stage run --openshell; fi
    spec="$PMOS_CONTENT_CHECKOUT/policies/bots/$bot.sandbox.yaml"
    policy="$PMOS_CONTENT_CHECKOUT/policies/bots/$bot.yaml"
    [ -f "$spec" ] && [ -f "$policy" ] || { say "no generated policy for $bot in the content checkout; run pmos policy generate and merge it" >&2; exit 1; }
    if [ "$bot" = docs ]; then
      rt=$PMOS_RT_DOCS_WORKER_TOKEN
      gw=$PMOS_GW_DOCS_BOT_TOKEN
    else
      rt=$(list_value "${PMOS_RT_WORKER_TOKENS:-}" "worker-$bot")
      gw=$(list_value "${PMOS_GW_BOT_TOKENS:-}" "bot-$bot")
      [ -n "$rt" ] && [ -n "$gw" ] || { say "run deploy/pmos-admin add-bot $bot first" >&2; exit 1; }
    fi
    [ "$dry" = 1 ] || worker_unit_checks
    sandbox="pmos-$bot"
    unit=$(worker_unit "$bot")
    # Uploads come from the generated spec: `from` is relative to the content root.
    uploads=()
    # Slice H12 (spec §3.6, V11): under hosted with a data-class ceiling below restricted, master
    # context counts as restricted unless its first line is a sensitivity marker, and a file
    # above the ceiling isn't uploaded (named with its class, never its text).
    ceiling=""
    if [ "${PMOS_MODEL_SOURCE:-}" = hosted ]; then
      ceiling=${PMOS_HOSTED_MAX_DATA_CLASS:-$(sed -n 's/^[[:space:]]*max_data_class:[[:space:]]*"\{0,1\}\([a-z]*\).*/\1/p' "$ROOT/$APPROVED_LIST" 2>/dev/null | head -1)}
    fi
    while read -r from to; do
      if [ -n "$ceiling" ] && [ "$ceiling" != restricted ] && [[ "$from" == master/* ]]; then
        cls=restricted
        case "$(head -n 1 "$PMOS_CONTENT_CHECKOUT/content/$from" 2>/dev/null)" in
          '<!-- sensitivity: public -->') cls=public ;;
          '<!-- sensitivity: internal -->') cls=internal ;;
        esac
        if [ "$cls" = restricted ] || { [ "$cls" = internal ] && [ "$ceiling" = public ]; }; then
          say "pmos-admin sandbox: content/$from counts as $cls data, above the hosted model's data-class ceiling ($ceiling); nothing was uploaded. If it holds less, mark its first line <!-- sensitivity: public --> or <!-- sensitivity: internal -->" >&2
          exit 2
        fi
      fi
      uploads+=(--upload "$PMOS_CONTENT_CHECKOUT/content/$from:$to")
    done < <(awk '/^  - from: /{f=$3} /^    to: /{print f, $2}' "$spec")
    pmos_sandbox_create_cmd "$sandbox" "${PMOS_VERSION:-local}" "$policy" \
      --provider "$sandbox-gateway" --provider "$sandbox-worker" "${uploads[@]}"
    create=("${SANDBOX_CREATE[@]}")
    if [ "$dry" = 1 ]; then
      # What would run; the tokens are never printed.
      say "openshell provider get $sandbox-gateway: if it exists, openshell provider update $sandbox-gateway --credential PMOS_GATEWAY_TOKEN; else openshell provider create --name $sandbox-gateway --type pmos-gateway --credential PMOS_GATEWAY_TOKEN  (the token from deploy/.env, in the environment)"
      say "openshell provider get $sandbox-worker: if it exists, openshell provider update $sandbox-worker --credential PMOS_WORKER_TOKEN; else openshell provider create --name $sandbox-worker --type pmos-worker --credential PMOS_WORKER_TOKEN  (the token from deploy/.env, in the environment)"
      say "openshell ${create[*]}"
      say "install $WORKER_UNIT_TEMPLATE as $(user_unit_dir)/pmos-worker@.service"
      say "systemctl --user daemon-reload"
      say "systemctl --user enable --now $unit"
      exit 0
    fi
    PMOS_GATEWAY_TOKEN=$gw provider_upsert "$sandbox-gateway" pmos-gateway PMOS_GATEWAY_TOKEN
    PMOS_WORKER_TOKEN=$rt provider_upsert "$sandbox-worker" pmos-worker PMOS_WORKER_TOKEN
    openshell "${create[@]}"
    install_worker_unit
    systemctl --user daemon-reload
    systemctl --user enable --now "$unit"
    say "sandbox $sandbox created; its worker runs as the user unit $unit"
    say "check it with: systemctl --user status '$unit'"
    ;;

  pause)
    # The unit is disabled as well as stopped, so a paused bot stays paused after a reboot.
    # A pause is the first step of an incident (docs/runbooks/incidents.md). So (the security
    # review of 6bb806f, S2): as root it refuses, as `sandbox` and `resume` do, because root's
    # `systemctl --user` and openshell aren't the gateway user's, and the worker unit would stay
    # enabled and start the worker again; when the unit can't be found or stopped it says so
    # plainly; and the sandbox is stopped whatever happened to the unit. Anything left undone is
    # listed at the end, and then the exit is 1.
    [ $# -eq 1 ] || { say "usage: pmos-admin pause <bot>" >&2; exit 2; }
    bot=$1
    require_bot_name pause "$bot"
    if command -v systemd-escape >/dev/null; then
      unit=$(worker_unit "$bot")
    else
      unit="pmos-worker@<systemd-escape -- $bot>.service"
    fi
    if [ "$(id -u)" = 0 ]; then
      say "run pause as the user whose OpenShell gateway runs, not as root or with sudo: root's systemctl --user" >&2
      say "and openshell aren't that user's, so the worker unit would stay enabled and start the worker again." >&2
      say "As that user: deploy/pmos-admin pause $bot" >&2
      say "or by hand: systemctl --user disable --now '$unit'; openshell sandbox stop -n pmos-$bot" >&2
      exit 1
    fi
    left=()
    if ! command -v systemctl >/dev/null || ! command -v systemd-escape >/dev/null; then
      left+=("systemctl or systemd-escape isn't installed, so no worker unit was stopped: if pmos-$bot's worker runs, stop it (pgrep -af 'openshell sandbox exec -n pmos-$bot')")
    elif systemctl --user disable --now "$unit"; then
      # Tried whether or not the template is under this caller's XDG_CONFIG_HOME: the user's
      # systemd may have it from another directory (the review of eb49991).
      say "worker unit $unit stopped and disabled"
    elif [ ! -f "$(user_unit_dir)/pmos-worker@.service" ]; then
      say "couldn't stop and disable $unit, and no worker unit is installed for $(id -un) ($(user_unit_dir)/pmos-worker@.service is missing); stopping the sandbox anyway" >&2
      left+=("no worker unit was found for $(id -un): if pmos-$bot's worker was started another way (with & before slice H0, or as another user), find and stop it: pgrep -af 'openshell sandbox exec -n pmos-$bot'")
    else
      say "couldn't stop and disable $unit; stopping the sandbox anyway" >&2
      left+=("the worker unit $unit may still be enabled or running: systemctl --user status '$unit', then systemctl --user disable --now '$unit'")
    fi
    if ! command -v openshell >/dev/null; then
      left+=("openshell isn't on PATH, so the sandbox pmos-$bot was NOT stopped: openshell sandbox stop -n pmos-$bot (or openshell sandbox delete pmos-$bot)")
    elif openshell sandbox stop -n "pmos-$bot"; then
      say "pmos-$bot stopped; its queued tasks wait (and fail after their retry) until resume"
    else
      left+=("the sandbox pmos-$bot was NOT stopped: openshell sandbox stop -n pmos-$bot (or openshell sandbox delete pmos-$bot), then check openshell sandbox list")
    fi
    if [ ${#left[@]} -gt 0 ]; then
      say "pause of $bot is NOT complete. Left to do:" >&2
      for l in "${left[@]}"; do say "  - $l" >&2; done
      exit 1
    fi
    ;;

  resume)
    # Also how a sandbox made before the worker unit existed gets one (docs/runbooks/upgrade.md).
    [ $# -eq 1 ] || { say "usage: pmos-admin resume <bot>" >&2; exit 2; }
    require_bot_name resume "$1"
    command -v openshell >/dev/null || { say "openshell is not installed" >&2; exit 1; }
    worker_unit_checks
    # The service names (slice H2's check, which resume skipped) and the rest of the host, with
    # the OpenShell checks (slice H1).
    if ! problems=$(host_names_problems); then
      {
        say "pmos-admin resume: the service names fail their check:"
        sed 's/^/  /' <<<"$problems"
        say "Fix it, then run this again: sudo deploy/pmos-admin host-names apply"
      } >&2
      exit 2
    fi
    run_preflight resume --stage run --openshell
    unit=$(worker_unit "$1")
    openshell sandbox start -n "pmos-$1"
    install_worker_unit
    systemctl --user daemon-reload
    # A unit that hit its start limit stays failed until this.
    systemctl --user reset-failed "$unit" 2>/dev/null || true
    systemctl --user enable --now "$unit"
    say "pmos-$1 started; its worker runs as the user unit $unit"
    ;;

  host-names)
    # Slice H2 (docs/openshell-any-host-spec.md §3.3 step 4). No argument beyond the action: the
    # block always holds the pinned addresses, and there is no override of them or of the file.
    hn_usage() { say "usage: sudo deploy/pmos-admin host-names apply, or deploy/pmos-admin host-names check (nothing else: the block always holds the pinned addresses)" >&2; exit 2; }
    [ $# -eq 1 ] || hn_usage
    case "$1" in
      apply) host_names_apply ;;
      check)
        if problems=$(host_names_problems); then
          host_names_ok_lines | sed 's/^/  ok    /'
        else
          sed 's/^/  FAIL  /' <<<"$problems"
          exit 1
        fi
        ;;
      *) hn_usage ;;
    esac
    ;;

  preflight)
    # By hand: every argument goes to deploy/preflight.sh (see its --help); deploy/.env is this
    # deployment's. Its exit status is the preflight's.
    code=0
    "$PREFLIGHT" --env-file "$ENV" "$@" || code=$?
    exit "$code"
    ;;

  host-firewall)
    hf_usage() { say "usage: sudo deploy/pmos-admin host-firewall apply|remove, or deploy/pmos-admin host-firewall check" >&2; exit 2; }
    [ $# -eq 1 ] || hf_usage
    case "$1" in
      apply)
        host_firewall_apply
        if problems=$(host_firewall_problems) && [ -n "$problems" ]; then
          sed 's/^/  FAIL  /' <<<"$problems" >&2
          exit 1
        fi
        ;;
      remove) host_firewall_remove ;;
      check)
        problems=$(host_firewall_problems)
        if [ -n "$problems" ]; then
          sed 's/^/  FAIL  /' <<<"$problems"
          exit 1
        fi
        say "  ok    the metadata block's rules, the docker.service drop-in and pmos-metadata-block.timer are in place"
        ;;
      *) hf_usage ;;
    esac
    ;;

  host)
    host_cmd "$@"
    ;;

  hosted)
    hosted_cmd "$@"
    ;;

  hosted-key)
    # Slice H12: the hosted model's key, from standard input (never an argument, never printed),
    # into deploy/secrets/hosted-model.key (dir 700, file 600), mounted into the gateway only.
    [ $# -eq 1 ] && [ "$1" = set ] || { say "usage: deploy/pmos-admin hosted-key set (the key on standard input)" >&2; exit 2; }
    hosted_key_set
    ;;

  lint)
    pmos_cli sh -c 'pmos lint --root content && pmos policy check --root content --policies policies'
    ;;

  pmos)
    pmos_cli pmos "$@"
    ;;

  evals)
    # The benchmarks and load test (docs/evals.md), run in the image on the stack's network.
    # Reports are written to evals/reports in the content checkout; commit them.
    # The token by name only (`-e NAME`): docker takes the value from this environment, so it
    # isn't on docker's command line (the security review of 6bb806f, S1).
    PMOS_EVALS_TOKEN=${PMOS_RT_EVALS_TOKEN:-} docker run --rm --user "${PMOS_UID:-10001}:${PMOS_GID:-10001}" \
      --network pmos_pmos -v "$PMOS_CONTENT_CHECKOUT:/srv/content-repo" -w /srv/content-repo \
      -e PMOS_BOTS_URL=http://bots.pmos.internal:8750 -e PMOS_EVALS_TOKEN \
      -e PMOS_EVALS_ROOT=evals "pmos:${PMOS_VERSION:-local}" pmos-evals "$@"
    ;;

  evals-run|evals-stack)
    # evals-run: `pmos-evals run <args>`; evals-stack: `pmos-evals <args>` (judge calibrate, …).
    checkout=$PMOS_CONTENT_CHECKOUT
    args=()
    [ "$cmd" = evals-run ] && args+=(run)
    while [ $# -gt 0 ]; do
      case "$1" in
        --checkout) checkout=$2; shift 2 ;;
        *) args+=("$1"); shift ;;
      esac
    done
    eval_stack_up "$checkout"
    evals_runner "${args[@]}"
    if [ "$cmd" = evals-run ]; then
      say "report written under $checkout/evals/reports; commit it so the gate can compare against it"
    fi
    ;;

  evals-gate)
    # The eval gate. --checkout names the tree being measured (CI: the PR's head, in pr/). That
    # tree is data: only git runs on it (diff, archive), and the eval stack's containers, which
    # run this machine's installed images, read its content/, evals/ and deploy/gateway.yaml.
    # Nothing from it is sourced or executed, and the compose file is this script's own.
    base=origin/main
    checkout=$ROOT
    dry=0
    gate_usage() { say "usage: pmos-admin evals-gate [--checkout <dir>] [--base <ref>] [--dry-run]" >&2; exit 2; }
    while [ $# -gt 0 ]; do
      case "$1" in
        --base) [ $# -ge 2 ] || gate_usage; base=$2; shift 2 ;;
        --checkout) [ $# -ge 2 ] || gate_usage; checkout=$2; shift 2 ;;
        --dry-run) dry=1; shift ;;
        *) gate_usage ;;
      esac
    done
    # The base goes to `git diff` and `git archive` as a revision: one that starts with `-` would
    # be read as an option (`--output=<file>`, `--remote=…`). So it is refused here, and both git
    # commands also get it after `--end-of-options` (git 2.24 and later), which ends their
    # options without making what follows a path, as `--` would.
    case "$base" in -* | '') say "--base must name a revision, not $(printf '%q' "$base")" >&2; exit 2 ;; esac
    [ -d "$checkout" ] || { say "no directory $checkout" >&2; exit 2; }
    checkout=$(cd "$checkout" && pwd)
    if [ "$dry" = 1 ]; then
      # What the gate would use, without starting anything (scripts and CI check the parse).
      say "checkout=$checkout"
      say "base=$base"
      exit 0
    fi
    changed=$(git -C "$checkout" diff --name-only --end-of-options "$base"...HEAD)
    eval_stack_up "$checkout"
    mapfile -t categories < <(printf '%s\n' "$changed" | evals_runner affected --content content)
    if [ ${#categories[@]} -eq 0 ]; then
      say "The eval gate: no benchmark category is affected by this change."
      exit 0
    fi
    # The baseline: the base branch's committed reports, unpacked where the runner can read them.
    git -C "$checkout" archive --end-of-options "$base" evals/reports | tar -x -C "$PMOS_EVAL_BASELINE"
    worst=0
    for c in "${categories[@]}"; do
      code=0
      evals_runner gate --category "$c" --baseline-reports /srv/baseline/evals/reports \
        --reports-dir /srv/out || code=$?
      echo
      [ "$code" -gt "$worst" ] && worst=$code
    done
    exit "$worst"
    ;;

  smoke)
    # One Docs-bot question through the whole stack, as the Slack bot would send it.
    [ $# -eq 1 ] || { say "usage: pmos-admin smoke <handle of an active user>" >&2; exit 2; }
    handle=$1
    require_handle smoke "$handle"
    token_ok PMOS_RT_SLACK_TOKEN || exit 2
    # The Slack runtime token on curl's standard input (bearer_config), never its command line.
    rt_curl() {
      { bearer_config PMOS_RT_SLACK_TOKEN; printf 'header = "X-Pmos-User: %s"\n' "$handle"; } |
        curl --config - -sS --noproxy '*' "$@"
    }
    # The task's JSON from a real encoder (jq, or python3 where jq isn't installed).
    if command -v jq >/dev/null; then
      body=$(jq -cn --arg who "$handle" '{bot: "docs", requested_by: $who,
        text: "What does the docs site say about getting started?", source: "slack",
        slack: {channel: "smoke", thread_ts: "0.0"}}')
    elif command -v python3 >/dev/null; then
      body=$(python3 -I -c 'import json, sys
print(json.dumps({"bot": "docs", "requested_by": sys.argv[1],
  "text": "What does the docs site say about getting started?", "source": "slack",
  "slack": {"channel": "smoke", "thread_ts": "0.0"}}, separators=(",", ":")))' "$handle")
    else
      say "smoke needs jq or python3 to write the task's JSON" >&2
      exit 1
    fi
    task=$(rt_curl -X POST "http://127.0.0.1:$PMOS_BOTS_PORT/v1/tasks" -H 'content-type: application/json' -d "$body")
    id=$(sed -n 's/.*"id":"\(tsk_[0-9a-f]*\)".*/\1/p' <<<"$task")
    [ -n "$id" ] || { say "the runtime refused the task: $task" >&2; exit 1; }
    say "task $id queued; waiting up to 3 minutes for a worker"
    status=queued
    for _ in $(seq 1 90); do
      status=$(rt_curl "http://127.0.0.1:$PMOS_BOTS_PORT/v1/tasks/$id" | sed -n 's/.*"status":"\([a-z_]*\)".*/\1/p')
      case "$status" in done|failed|cancelled|needs_approval) break ;; esac
      sleep 2
    done
    rt_curl "http://127.0.0.1:$PMOS_BOTS_PORT/v1/tasks/$id/events" | tr '{' '\n' | sed -n 's/.*"kind":"\([a-z_]*\)".*"text":"\([^"]*\)".*/  \1: \2/p'
    echo
    if [ "$status" = done ]; then say "smoke test passed"; else say "smoke test ended as: $status" >&2; exit 1; fi
    ;;

  upstream-key)
    # Slice MP2 (docs/model-providers-spec.md §4.11): one key per upstream, read from standard
    # input (never an argument, never printed), into deploy/secrets/upstream-<u>.key (dir 700,
    # file 600), which `up` mounts into the gateway only.
    [ $# -eq 2 ] && [ "$1" = set ] || { say "usage: pmos-admin upstream-key set <upstream> (the key on standard input)" >&2; exit 2; }
    u=$2
    [[ "$u" =~ $UPSTREAM_NAME_RE ]] || { say "an upstream's name is 1 to 32 lowercase letters, digits and inner hyphens (as in the route config's upstreams:)" >&2; exit 2; }
    dir="$DEPLOY/secrets"
    (umask 077 && mkdir -p "$dir") && chmod 700 "$dir"
    if [ -t 0 ]; then
      printf 'key for upstream %s (not shown): ' "$u" >&2
      IFS= read -rs key || true
      printf '\n' >&2
    else
      IFS= read -r key || true
    fi
    key=${key%$'\r'}
    if [ -z "$key" ] || [[ "$key" == *[[:space:]]* ]]; then
      say "no key was read, or it has spaces in it; nothing was written" >&2
      exit 2
    fi
    dest="$dir/upstream-$u.key"
    (umask 077 && printf '%s\n' "$key" >"$dest.new") && chmod 600 "$dest.new" && mv -f "$dest.new" "$dest" ||
      { rm -f "$dest.new"; say "couldn't write $dest" >&2; exit 1; }
    unset key
    say "wrote deploy/secrets/upstream-$u.key (mode 600); the gateway reads a changed key within a second, or restart it to mount a new upstream's"
    ;;

  route)
    # Slice MP8 (§4.11): $PMOS_STATE_DIR/route-control/disabled-<label>, which the gateway looks
    # at before every call, takes that model out of every route without a restart; each change
    # is a line in route-control/log.
    usage_route() { say "usage: pmos-admin route disable <label> --reason <text> | route enable <label>" >&2; exit 2; }
    [ $# -ge 2 ] || usage_route
    action=$1 label=$2
    shift 2
    [ ${#label} -le 64 ] && [ -n "$label" ] && only_chars "$label" "$LABEL_CHARS" || { say "a label is 1 to 64 letters, digits, . _ and -" >&2; exit 2; }
    [ -d "${PMOS_STATE_DIR:-}" ] || { say "PMOS_STATE_DIR isn't a directory: run deploy/setup.sh" >&2; exit 2; }
    dir="$PMOS_STATE_DIR/route-control"
    mkdir -p "$dir" && chmod 755 "$dir"
    who=${SUDO_USER:-$(id -un)}
    case "$action" in
      disable)
        [ $# -eq 2 ] && [ "$1" = --reason ] || usage_route
        reason=$2
        valid_reason "$reason" || { say "a reason is 1 to 200 printable characters on one line" >&2; exit 2; }
        (umask 022 && printf 'at=%s by=%s reason=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$who" "$reason" >"$dir/disabled-$label")
        (umask 022 && printf '%s\t%s\tdisable\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$who" "$label" "$reason" >>"$dir/log")
        say "disabled $label: no route uses it from the gateway's next call (a role with no other model answers 503)"
        ;;
      enable)
        [ $# -eq 0 ] || usage_route
        rm -f -- "$dir/disabled-$label"
        (umask 022 && printf '%s\t%s\tenable\t%s\t\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$who" "$label" >>"$dir/log")
        say "enabled $label"
        ;;
      *) usage_route ;;
    esac
    ;;

  routes)
    # Slice MP8 (§4.12): GET /v1/pmos/routes as the gateway's read-only admin client, whose
    # token is read by curl from standard input, never its arguments.
    [ $# -eq 0 ] || { say "usage: pmos-admin routes" >&2; exit 2; }
    token_ok PMOS_GW_ADMIN_TOKEN || { say "set PMOS_GW_ADMIN_TOKEN in deploy/.env (openssl rand -hex 24) and restart the gateway" >&2; exit 2; }
    bearer_config PMOS_GW_ADMIN_TOKEN | curl -sS --noproxy '*' -m 10 --config - "http://127.0.0.1:${PMOS_GATEWAY_PORT:-8740}/v1/pmos/routes"
    echo
    ;;

  usage)
    # Slice MP8 (§4.9): the gateway records tokens, never money. Tokens per model label from
    # the usage log, times $PMOS_STATE_DIR/prices.yaml (`<label>: <price per million tokens>`,
    # outside the repository: prices can identify a vendor) when it exists.
    [ $# -eq 1 ] && [ "$1" = --by-label ] || { say "usage: pmos-admin usage --by-label" >&2; exit 2; }
    log="${PMOS_STATE_DIR:-}/usage/usage.jsonl"
    [ -f "$log" ] || { say "no usage log at $log yet" >&2; exit 1; }
    python3 -I - "$log" "${PMOS_STATE_DIR:-}/prices.yaml" <<'PY'
import json, os, re, sys
log, prices_path = sys.argv[1], sys.argv[2]
prices = {}
if os.path.isfile(prices_path):
    for line in open(prices_path, encoding="utf-8"):
        m = re.match(r"^\s*([A-Za-z0-9._-]{1,64})\s*:\s*([0-9]+(?:\.[0-9]+)?)\s*(#.*)?$", line)
        if m:
            prices[m.group(1)] = float(m.group(2))
totals = {}
for line in open(log, encoding="utf-8"):
    try:
        e = json.loads(line)
    except ValueError:
        continue
    if not isinstance(e, dict):
        continue
    label = e.get("model") or "?"
    t = totals.setdefault(label, [0, 0, 0])
    t[0] += 1
    t[1] += e.get("prompt_tokens") or 0
    t[2] += e.get("completion_tokens") or 0
print("%-24s %8s %14s %14s %12s" % ("label", "attempts", "prompt", "completion", "cost"))
for label in sorted(totals):
    n, p, c = totals[label]
    cost = "%.4f" % ((p + c) / 1e6 * prices[label]) if label in prices else "-"
    print("%-24s %8d %14d %14d %12s" % (label[:24], n, p, c, cost))
PY
    ;;

  help|-h|--help)
    awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
    ;;

  *)
    say "unknown command $cmd; see deploy/pmos-admin help" >&2
    exit 2
    ;;
esac
