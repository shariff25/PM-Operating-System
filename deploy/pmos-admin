#!/usr/bin/env bash
# PM OS operations on the Spark, for platform-owner PMs (docs/runbooks/README.md).
#
#   pmos-admin build                  build the service and worker images on this machine
#   pmos-admin up [--models] [--console] [--bringup]
#                                     start the stack (Slack joins when its tokens are set)
#   pmos-admin down                   stop everything (data is kept)
#   pmos-admin status                 is every service up and ready?
#   pmos-admin logs <service> [-f]    a service's logs
#   pmos-admin restart <service>      restart one service
#   pmos-admin backup                 databases and logs to deploy/backups/<time>/
#   pmos-admin restore <dir>          put a backup back (stops the services while it runs)
#   pmos-admin reindex                reload content after a merge (lint-gated)
#   pmos-admin revoke <handle> <atlassian|slack|github>
#                                     remove a PM's linked account and its tokens
#   pmos-admin ledger [--since 7d] [--export]
#                                     what happened to the bots' drafts (feedback ledger)
#   pmos-admin add-bot <bot>          give a new bot its own runtime and gateway tokens
#   pmos-admin sandbox <bot>          create the bot's OpenShell sandbox and start its worker
#   pmos-admin pause <bot> / resume <bot>
#                                     stop or restart a bot's sandbox
#   pmos-admin lint                   pmos lint and pmos policy check on the content checkout
#   pmos-admin pmos <args>            the pmos CLI on the checkout, e.g. `pmos member add …`
#                                     (paths are relative to the checkout: --root content)
#   pmos-admin evals <args>           pmos-evals against the live stack (the load test)
#   pmos-admin evals-run --category <c> [--checkout <dir>] [--note <why>]
#                                     a benchmark on the eval stack (fake systems, real docs and
#                                     models); the report lands in <dir>/evals/reports to commit
#   pmos-admin evals-stack [--checkout <dir>] <pmos-evals args>
#                                     any pmos-evals command on the eval stack (judge calibrate …)
#   pmos-admin evals-gate [--checkout <dir>] [--base origin/main] [--dry-run]
#                                     the eval gate for a checkout's changes (default: this
#                                     one; CI passes the PR's head, which is only read as data)
#   pmos-admin smoke <handle>         one Docs-bot question through the whole stack
set -euo pipefail

DEPLOY="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$DEPLOY/.." && pwd)"
ENV="$DEPLOY/.env"
[ -f "$ENV" ] || { echo "no deploy/.env yet: run deploy/setup.sh first" >&2; exit 1; }
set -a
# shellcheck disable=SC1090
. "$ENV"
set +a

compose() { docker compose --project-directory "$DEPLOY" -f "$DEPLOY/compose.yaml" --env-file "$ENV" "$@"; }
say() { printf '%s\n' "$*"; }
row() { printf '  %-12s %-6s %s\n' "$1" "$2" "$3"; }

profiles() {
  local p=()
  if [ -n "${PMOS_SLACK_APP_TOKEN:-}" ] && [ -n "${PMOS_SLACK_BOT_TOKEN:-}" ]; then
    p+=(--profile slack)
  fi
  for arg in "$@"; do
    case "$arg" in
      --models) p+=(--profile models) ;;
      --console) p+=(--profile console) ;;
      --bringup) p+=(--profile bringup) ;;
      *) say "unknown option $arg" >&2; exit 2 ;;
    esac
  done
  [ ${#p[@]} -eq 0 ] || printf '%s\n' "${p[@]}"
}

# A call to the tool server's internal API as the orchestrator.
internal() { # method path [json]
  curl -fsS --noproxy '*' -X "$1" "http://127.0.0.1:8710$2" \
    -H "Authorization: Bearer $PMOS_SERVICE_TOKEN" -H 'content-type: application/json' \
    ${3:+-d "$3"}
}

# The `pmos` CLI in the image, in the content checkout, as the checkout's owner.
pmos_cli() {
  docker run --rm --user "${PMOS_UID:-10001}:${PMOS_GID:-10001}" \
    -v "$PMOS_CONTENT_CHECKOUT:/srv/content-repo" -w /srv/content-repo \
    "pmos:${PMOS_VERSION:-local}" "$@"
}

# --- The eval stack (deploy/compose.evals.yaml) ---------------------------------------------
# A separate, short-lived tool server, runtime and workers on a checkout's content, sharing only
# the live gateway (models) and docs server. Fresh tokens every time; removed afterwards.
EVAL_DIR=""
evals_compose() {
  docker compose --project-directory "$DEPLOY" -f "$DEPLOY/compose.evals.yaml" --env-file "$ENV" "$@"
}
eval_stack_up() { # checkout
  local checkout
  checkout=$(cd "$1" && pwd)
  [ -f "$checkout/content/tools.yaml" ] || { say "$checkout has no content/tools.yaml" >&2; exit 2; }
  if ! curl -fsS --noproxy '*' -m 5 http://127.0.0.1:8740/healthz >/dev/null 2>&1; then
    say "the gateway isn't running: start the stack first (deploy/pmos-admin up --models)" >&2
    exit 2
  fi
  EVAL_DIR=$(mktemp -d "${TMPDIR:-/tmp}/pmos-evals.XXXXXX")
  chmod 755 "$EVAL_DIR"
  # The checkout's content, plus the members the fake fixtures expect: `evals` (U0EVALS), whom
  # the benchmark tasks are requested by, with their personal bot pm-evals, and their teammates
  # ben (U0BEN) and cy (U0CY), so the fake channels' audiences mean what the tasks say
  # (crates/toolserver/src/connectors/fake.rs). Only this copy is changed.
  # -P: a symbolic link in the checkout is copied as a link, never followed on this machine.
  cp -RP "$checkout/content" "$EVAL_DIR/content"
  mkdir -p "$EVAL_DIR/baseline" "$EVAL_DIR/out"
  local who
  for who in evals:U0EVALS ben:U0BEN cy:U0CY; do
    docker run --rm --user "${PMOS_UID:-10001}:${PMOS_GID:-10001}" -v "$EVAL_DIR/content:/srv/content" \
      "pmos:${PMOS_VERSION:-local}" pmos member add --root /srv/content --handle "${who%%:*}" \
      --slack-id "${who##*:}" --roles pm >/dev/null
  done
  chown -R "${PMOS_UID:-10001}:${PMOS_GID:-10001}" "$EVAL_DIR" 2>/dev/null || true
  export PMOS_EVAL_CONTENT="$EVAL_DIR/content" PMOS_EVAL_CHECKOUT="$checkout" PMOS_EVAL_BASELINE="$EVAL_DIR/baseline" PMOS_EVAL_OUT="$EVAL_DIR/out"
  for v in SERVICE_TOKEN BOT_TOKEN RT_EVALS RT_CONSOLE RT_DOCS RT_PERSONAL; do
    export "PMOS_EVAL_$v=$(openssl rand -hex 24)"
  done
  trap eval_stack_down EXIT
  evals_compose up -d --wait toolserver bots worker-docs worker-personal >/dev/null
}
eval_stack_down() {
  evals_compose --profile runner down -v --remove-orphans >/dev/null 2>&1 || true
  [ -n "$EVAL_DIR" ] && rm -rf "$EVAL_DIR"
}
evals_runner() { evals_compose --profile runner run --rm -T runner "$@"; }

# Replace or append KEY=VALUE in deploy/.env.
set_env() {
  local tmp
  tmp=$(mktemp)
  if grep -qE "^$1=" "$ENV"; then
    awk -v k="$1" -v v="$2" -F= 'BEGIN{OFS="="} $1==k{print k, v; next} {print}' "$ENV" >"$tmp"
  else
    cat "$ENV" >"$tmp"
    printf '%s=%s\n' "$1" "$2" >>"$tmp"
  fi
  cat "$tmp" >"$ENV"
  rm -f "$tmp"
}

cmd=${1:-help}
shift || true
case "$cmd" in
  build)
    args=(--build-arg "HTTPS_PROXY=${HTTPS_PROXY:-}" --build-arg "NO_PROXY=${NO_PROXY:-}")
    if [ -n "${HTTPS_PROXY:-}" ]; then args+=(--network host); fi
    if [ -n "${PMOS_BUILD_CA:-}" ]; then args+=(--secret "id=ca,src=$PMOS_BUILD_CA"); fi
    tag=${PMOS_VERSION:-local}
    say "== building pmos:$tag (the Rust services; the first build takes a while)"
    DOCKER_BUILDKIT=1 docker build "${args[@]}" -f "$DEPLOY/Dockerfile" -t "pmos:$tag" "$ROOT"
    say "== building pmos-worker:$tag (the bots' sandbox image)"
    DOCKER_BUILDKIT=1 docker build "${args[@]}" -f "$DEPLOY/Dockerfile.worker" -t "pmos-worker:$tag" "$ROOT"
    ;;

  up)
    mapfile -t prof < <(profiles "$@")
    if [ -z "${PMOS_SLACK_APP_TOKEN:-}" ] || [ -z "${PMOS_SLACK_BOT_TOKEN:-}" ]; then
      say "note: the Slack bot is off until PMOS_SLACK_APP_TOKEN and PMOS_SLACK_BOT_TOKEN are set"
    fi
    compose "${prof[@]}" up -d
    say "started; check with: deploy/pmos-admin status"
    ;;

  down)
    compose --profile slack --profile console --profile models --profile bringup down
    ;;

  status)
    say "== containers"
    compose --profile slack --profile console --profile models --profile bringup ps \
      --format 'table {{.Service}}\t{{.Status}}'
    say "== readiness"
    check() { # name url
      local body code
      body=$(curl -sS --noproxy '*' -m 5 -w '\n%{http_code}' "$2" 2>/dev/null) || { row "$1" DOWN "no answer from $2"; return; }
      code=${body##*$'\n'}
      body=${body%$'\n'*}
      if [ "$code" = 200 ]; then row "$1" ok "${body:0:90}"; else row "$1" "$code" "${body:0:90}"; fi
    }
    check toolserver http://127.0.0.1:8710/readyz
    check gateway http://127.0.0.1:8740/readyz
    check bots http://127.0.0.1:8750/readyz
    if compose --profile console ps --status running --services 2>/dev/null | grep -qx console; then
      check console http://127.0.0.1:8760/healthz
    fi
    if compose exec -T docs curl -fsS -m 5 http://127.0.0.1:8730/readyz >/dev/null 2>&1; then
      row docs ok "ready"
    else
      row docs "not" "ready (normal until the first sync finishes; or no docs site set in PMOS_DOCS_BASE_URL)"
    fi
    ;;

  logs)
    [ $# -ge 1 ] || { say "usage: pmos-admin logs <service> [-f]" >&2; exit 2; }
    svc=$1
    shift
    compose --profile slack --profile console --profile models --profile bringup logs --tail 200 "$@" "$svc"
    ;;

  restart)
    [ $# -eq 1 ] || { say "usage: pmos-admin restart <service>" >&2; exit 2; }
    compose --profile slack --profile console --profile models --profile bringup restart "$1"
    ;;

  backup)
    dir="$DEPLOY/backups/$(date -u +%Y%m%dT%H%M%SZ)"
    mkdir -p "$dir"
    chmod 700 "$dir"
    for db in toolserver bots docs; do
      say "  dumping pmos_$db"
      compose exec -T postgres pg_dump -U postgres -Fc "pmos_$db" >"$dir/pmos_$db.dump"
    done
    for d in audit usage; do
      if [ -d "$PMOS_STATE_DIR/$d" ]; then tar -C "$PMOS_STATE_DIR" -czf "$dir/$d.tgz" "$d"; fi
    done
    (cd "$dir" && sha256sum ./* >SHA256SUMS)
    say "backup in $dir"
    say "It holds sealed tokens: keep it with deploy/.env's vault key, and both somewhere safe."
    ;;

  restore)
    [ $# -eq 1 ] && [ -d "$1" ] || { say "usage: pmos-admin restore <backup dir>" >&2; exit 2; }
    dir=$(cd "$1" && pwd)
    (cd "$dir" && sha256sum -c --quiet SHA256SUMS) || { say "the backup's checksums don't match; not restoring" >&2; exit 1; }
    say "This replaces every PM OS database with the backup in $dir."
    read -r -p "Type RESTORE to go on: " answer
    [ "$answer" = RESTORE ] || { say "stopped; nothing changed"; exit 1; }
    compose --profile slack --profile console --profile bringup stop docs toolserver gateway bots slack console worker-docs 2>/dev/null || true
    compose up -d postgres
    until compose exec -T postgres pg_isready -U postgres >/dev/null 2>&1; do sleep 1; done
    for db in toolserver bots docs; do
      say "  restoring pmos_$db"
      compose exec -T postgres psql -U postgres -v ON_ERROR_STOP=1 -q \
        -c "DROP DATABASE IF EXISTS pmos_$db WITH (FORCE)" -c "CREATE DATABASE pmos_$db OWNER pmos_$db"
      compose exec -T postgres pg_restore -U postgres --role="pmos_$db" --no-owner -d "pmos_$db" <"$dir/pmos_$db.dump"
    done
    for d in audit usage; do
      if [ -f "$dir/$d.tgz" ]; then tar -C "$PMOS_STATE_DIR" -xzf "$dir/$d.tgz"; fi
    done
    say "restored; start the services again with: deploy/pmos-admin up"
    ;;

  reindex)
    internal POST /internal/reindex && echo
    ;;

  revoke)
    [ $# -eq 2 ] || { say "usage: pmos-admin revoke <handle> <atlassian|slack|github>" >&2; exit 2; }
    internal DELETE "/internal/credentials/$1/$2" && say "revoked $2 for $1"
    ;;

  ledger)
    since=7d
    export=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --since) since=$2; shift 2 ;;
        --export) export=1; shift ;;
        *) say "usage: pmos-admin ledger [--since 7d|24h|<date>] [--export]" >&2; exit 2 ;;
      esac
    done
    case "$since" in
      *d) from=$(date -u -d "-${since%d} days" +%Y-%m-%dT%H:%M:%SZ) ;;
      *h) from=$(date -u -d "-${since%h} hours" +%Y-%m-%dT%H:%M:%SZ) ;;
      *) from=$(date -u -d "$since" +%Y-%m-%dT%H:%M:%SZ) ;;
    esac
    if [ "$export" = 1 ]; then
      # JSON lines, one ledger row each (labels and metadata only; no message text).
      internal GET "/internal/ledger?since=$from&limit=1000" | python3 -c 'import json,sys
for r in json.load(sys.stdin)["rows"]: print(json.dumps(r))'
      exit 0
    fi
    internal GET "/internal/ledger/summary?since=$from" | python3 -c '
import json, sys
s = json.load(sys.stdin)
print(f"drafts since {s.get("since", "?")}: {s["rows"]}, labelled {s["label_coverage"]:.0%} (phase 0 gate: 95%)")
print(f"  {"bot/skill":<18} {"tool":<26} {"n":>4} {"ok":>4} {"edit":>4} {"rej":>4} {"exp":>4} {"med edit":>8}  reasons")
for g in s["groups"]:
    c = g["counts"]
    med = g.get("median_edit_distance")
    reasons = ", ".join(f"{k} {v}" for k, v in sorted(g.get("reasons", {}).items()) if v)
    who = g.get("bot") or g.get("skill") or "?"
    print(f"  {who:<18} {g["tool"]:<26} {g["rows"]:>4} {c.get("approved",0):>4} {c.get("edited",0):>4} {c.get("rejected",0):>4} {c.get("expired",0):>4} {(f"{med:.0%}" if med is not None else "-"):>8}  {reasons}")
'
    ;;

  add-bot)
    [ $# -eq 1 ] || { say "usage: pmos-admin add-bot <bot>" >&2; exit 2; }
    bot=$1
    if [ "$bot" = docs ]; then
      say "the Docs bot's tokens are built in (PMOS_RT_DOCS_WORKER_TOKEN)"
      exit 0
    fi
    if [[ ",${PMOS_RT_WORKER_TOKENS:-}," == *",worker-$bot="* ]]; then
      say "$bot already has tokens"
      exit 0
    fi
    rt=$(openssl rand -hex 24)
    gw=$(openssl rand -hex 24)
    set_env PMOS_RT_WORKER_TOKENS "${PMOS_RT_WORKER_TOKENS:+$PMOS_RT_WORKER_TOKENS,}worker-$bot=$rt"
    set_env PMOS_GW_BOT_TOKENS "${PMOS_GW_BOT_TOKENS:+$PMOS_GW_BOT_TOKENS,}bot-$bot=$gw"
    compose up -d bots gateway
    say "tokens added for $bot; the runtime and gateway were restarted with them."
    say "next: deploy/pmos-admin sandbox $bot"
    ;;

  sandbox)
    # Verify on the Spark: the OpenShell command names and flags (`--image`, keeping the worker
    # running after `sandbox exec`), as listed in docs/sandbox-policies.md.
    [ $# -eq 1 ] || { say "usage: pmos-admin sandbox <bot>" >&2; exit 2; }
    bot=$1
    command -v openshell >/dev/null || { say "openshell is not installed" >&2; exit 1; }
    spec="$PMOS_CONTENT_CHECKOUT/policies/bots/$bot.sandbox.yaml"
    policy="$PMOS_CONTENT_CHECKOUT/policies/bots/$bot.yaml"
    [ -f "$spec" ] && [ -f "$policy" ] || { say "no generated policy for $bot in the content checkout; run pmos policy generate and merge it" >&2; exit 1; }
    if [ "$bot" = docs ]; then
      rt=$PMOS_RT_DOCS_WORKER_TOKEN
      gw=$PMOS_GW_DOCS_BOT_TOKEN
    else
      rt=$(tr ',' '\n' <<<"${PMOS_RT_WORKER_TOKENS:-}" | sed -n "s/^worker-$bot=//p")
      gw=$(tr ',' '\n' <<<"${PMOS_GW_BOT_TOKENS:-}" | sed -n "s/^bot-$bot=//p")
      [ -n "$rt" ] && [ -n "$gw" ] || { say "run deploy/pmos-admin add-bot $bot first" >&2; exit 1; }
    fi
    sandbox="pmos-$bot"
    # Uploads come from the generated spec: `from` is relative to the content root.
    uploads=()
    while read -r from to; do
      uploads+=(--upload "$PMOS_CONTENT_CHECKOUT/content/$from:$to")
    done < <(awk '/^  - from: /{f=$3} /^    to: /{print f, $2}' "$spec")
    PMOS_GATEWAY_TOKEN=$gw openshell provider create --name "$sandbox-gateway" --type pmos-gateway --credential PMOS_GATEWAY_TOKEN
    PMOS_WORKER_TOKEN=$rt openshell provider create --name "$sandbox-worker" --type pmos-worker --credential PMOS_WORKER_TOKEN
    openshell sandbox create --name "$sandbox" --image "pmos-worker:${PMOS_VERSION:-local}" --policy "$policy" \
      --provider "$sandbox-gateway" --provider "$sandbox-worker" "${uploads[@]}"
    openshell sandbox exec -n "$sandbox" --workdir /sandbox/workspace -- env \
      PMOS_BOTS_URL=http://bots.pmos.internal:8750 PMOS_WORKER_BOT="$bot" \
      PMOS_GATEWAY_URL=http://gateway.pmos.internal:8740/v1 \
      PMOS_TOOLSERVER_MCP_URL=http://toolserver.pmos.internal:8710/mcp \
      PMOS_CONTENT_ROOT=/sandbox \
      /usr/local/bin/node /opt/pmos/harness/dist/main.js &
    say "sandbox $sandbox created and its worker started"
    ;;

  pause)
    [ $# -eq 1 ] || { say "usage: pmos-admin pause <bot>" >&2; exit 2; }
    openshell sandbox stop -n "pmos-$1"
    say "pmos-$1 stopped; its queued tasks wait (and fail after their retry) until resume"
    ;;

  resume)
    [ $# -eq 1 ] || { say "usage: pmos-admin resume <bot>" >&2; exit 2; }
    openshell sandbox start -n "pmos-$1"
    ;;

  lint)
    pmos_cli sh -c 'pmos lint --root content && pmos policy check --root content --policies policies'
    ;;

  pmos)
    pmos_cli pmos "$@"
    ;;

  evals)
    # The benchmarks and load test (docs/evals.md), run in the image on the stack's network.
    # Reports are written to evals/reports in the content checkout; commit them.
    docker run --rm --user "${PMOS_UID:-10001}:${PMOS_GID:-10001}" --network pmos_pmos \
      -v "$PMOS_CONTENT_CHECKOUT:/srv/content-repo" -w /srv/content-repo \
      -e PMOS_BOTS_URL=http://bots.pmos.internal:8750 -e PMOS_EVALS_TOKEN="$PMOS_RT_EVALS_TOKEN" \
      -e PMOS_EVALS_ROOT=evals "pmos:${PMOS_VERSION:-local}" pmos-evals "$@"
    ;;

  evals-run|evals-stack)
    # evals-run: `pmos-evals run <args>`; evals-stack: `pmos-evals <args>` (judge calibrate, …).
    checkout=$PMOS_CONTENT_CHECKOUT
    args=()
    [ "$cmd" = evals-run ] && args+=(run)
    while [ $# -gt 0 ]; do
      case "$1" in
        --checkout) checkout=$2; shift 2 ;;
        *) args+=("$1"); shift ;;
      esac
    done
    eval_stack_up "$checkout"
    evals_runner "${args[@]}"
    if [ "$cmd" = evals-run ]; then
      say "report written under $checkout/evals/reports; commit it so the gate can compare against it"
    fi
    ;;

  evals-gate)
    # The eval gate. --checkout names the tree being measured (CI: the PR's head, in pr/). That
    # tree is data: only git runs on it (diff, archive), and the eval stack's containers, which
    # run this machine's installed images, read its content/, evals/ and deploy/gateway.yaml.
    # Nothing from it is sourced or executed, and the compose file is this script's own.
    base=origin/main
    checkout=$ROOT
    dry=0
    gate_usage() { say "usage: pmos-admin evals-gate [--checkout <dir>] [--base <ref>] [--dry-run]" >&2; exit 2; }
    while [ $# -gt 0 ]; do
      case "$1" in
        --base) [ $# -ge 2 ] || gate_usage; base=$2; shift 2 ;;
        --checkout) [ $# -ge 2 ] || gate_usage; checkout=$2; shift 2 ;;
        --dry-run) dry=1; shift ;;
        *) gate_usage ;;
      esac
    done
    [ -d "$checkout" ] || { say "no directory $checkout" >&2; exit 2; }
    checkout=$(cd "$checkout" && pwd)
    if [ "$dry" = 1 ]; then
      # What the gate would use, without starting anything (scripts and CI check the parse).
      say "checkout=$checkout"
      say "base=$base"
      exit 0
    fi
    changed=$(git -C "$checkout" diff --name-only "$base"...HEAD)
    eval_stack_up "$checkout"
    mapfile -t categories < <(printf '%s\n' "$changed" | evals_runner affected --content content)
    if [ ${#categories[@]} -eq 0 ]; then
      say "The eval gate: no benchmark category is affected by this change."
      exit 0
    fi
    # The baseline: the base branch's committed reports, unpacked where the runner can read them.
    git -C "$checkout" archive "$base" evals/reports | tar -x -C "$PMOS_EVAL_BASELINE"
    worst=0
    for c in "${categories[@]}"; do
      code=0
      evals_runner gate --category "$c" --baseline-reports /srv/baseline/evals/reports \
        --reports-dir /srv/out || code=$?
      echo
      [ "$code" -gt "$worst" ] && worst=$code
    done
    exit "$worst"
    ;;

  smoke)
    # One Docs-bot question through the whole stack, as the Slack bot would send it.
    [ $# -eq 1 ] || { say "usage: pmos-admin smoke <handle in team.yaml>" >&2; exit 2; }
    auth=(-H "Authorization: Bearer $PMOS_RT_SLACK_TOKEN" -H "X-Pmos-User: $1")
    body=$(printf '{"bot":"docs","requested_by":"%s","text":"What does the docs site say about getting started?","source":"slack","slack":{"channel":"smoke","thread_ts":"0.0"}}' "$1")
    task=$(curl -sS --noproxy '*' -X POST http://127.0.0.1:8750/v1/tasks "${auth[@]}" -H 'content-type: application/json' -d "$body")
    id=$(sed -n 's/.*"id":"\(tsk_[0-9a-f]*\)".*/\1/p' <<<"$task")
    [ -n "$id" ] || { say "the runtime refused the task: $task" >&2; exit 1; }
    say "task $id queued; waiting up to 3 minutes for a worker"
    status=queued
    for _ in $(seq 1 90); do
      status=$(curl -sS --noproxy '*' "http://127.0.0.1:8750/v1/tasks/$id" "${auth[@]}" | sed -n 's/.*"status":"\([a-z_]*\)".*/\1/p')
      case "$status" in done|failed|cancelled|needs_approval) break ;; esac
      sleep 2
    done
    curl -sS --noproxy '*' "http://127.0.0.1:8750/v1/tasks/$id/events" "${auth[@]}" | tr '{' '\n' | sed -n 's/.*"kind":"\([a-z_]*\)".*"text":"\([^"]*\)".*/  \1: \2/p'
    echo
    if [ "$status" = done ]; then say "smoke test passed"; else say "smoke test ended as: $status" >&2; exit 1; fi
    ;;

  help|-h|--help)
    awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
    ;;

  *)
    say "unknown command $cmd; see deploy/pmos-admin help" >&2
    exit 2
    ;;
esac
