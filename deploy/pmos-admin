#!/usr/bin/env bash
# PM OS operations on the Spark, for platform-owner PMs (docs/runbooks/README.md).
#
#   pmos-admin build                  build the service and worker images on this machine
#   pmos-admin up [--models] [--console] [--web] [--bringup]
#                                     start the stack (Slack joins when its tokens are set)
#   pmos-admin down                   stop everything (data is kept)
#   pmos-admin status                 is every service up and ready?
#   pmos-admin logs <service> [-f]    a service's logs
#   pmos-admin restart <service>      restart one service
#   pmos-admin backup                 databases and logs to deploy/backups/<time>/
#   pmos-admin restore <dir>          put a backup back (stops the services while it runs)
#   pmos-admin reindex                reload content after a merge (lint-gated)
#   pmos-admin audit purge --dry-run  how many audit events the next daily purge deletes
#   pmos-admin revoke <handle> <atlassian|slack|github>
#                                     remove a PM's linked account and its tokens
#   pmos-admin users <command> …      the user database, on the host (docs/runbooks/users.md):
#                                     bootstrap-admin, grant-admin, revoke-admin, set-entra,
#                                     unset-entra, set-sign-in-name, set-atlassian-email,
#                                     deactivate, reactivate, pilot-exception, import, export,
#                                     list; each records the OS user who ran it
#   pmos-admin ledger [--since 7d] [--export]
#                                     what happened to the bots' drafts (feedback ledger)
#   pmos-admin add-bot <bot>          give a new bot its own runtime and gateway tokens
#   pmos-admin sandbox <bot> [--dry-run]
#                                     create the bot's OpenShell sandbox and start its worker as
#                                     a systemd user unit (--dry-run: print what it would run)
#   pmos-admin pause <bot> / resume <bot>
#                                     stop or restart a bot's sandbox and its worker unit
#   pmos-admin lint                   pmos lint and pmos policy check on the content checkout
#   pmos-admin pmos <args>            the pmos CLI on the checkout, e.g. `pmos bot add-personal …`
#                                     (paths are relative to the checkout: --root content)
#   pmos-admin evals <args>           pmos-evals against the live stack (the load test)
#   pmos-admin evals-run --category <c> [--checkout <dir>] [--note <why>]
#                                     a benchmark on the eval stack (fake systems, real docs and
#                                     models); the report lands in <dir>/evals/reports to commit
#   pmos-admin evals-stack [--checkout <dir>] <pmos-evals args>
#                                     any pmos-evals command on the eval stack (judge calibrate …)
#   pmos-admin evals-gate [--checkout <dir>] [--base origin/main] [--dry-run]
#                                     the eval gate for a checkout's changes (default: this
#                                     one; CI passes the PR's head, which is only read as data)
#   pmos-admin smoke <handle>         one Docs-bot question through the whole stack
set -euo pipefail

DEPLOY="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$DEPLOY/.." && pwd)"
ENV="$DEPLOY/.env"
[ -f "$ENV" ] || { echo "no deploy/.env yet: run deploy/setup.sh first" >&2; exit 1; }

compose() { docker compose --project-directory "$DEPLOY" -f "$DEPLOY/compose.yaml" --env-file "$ENV" "$@"; }
say() { printf '%s\n' "$*"; }

# deploy/.env is read as data, never run as shell (slice H0; docs/openshell-any-host-spec.md,
# surprise 12). It used to be sourced (`set -a; . deploy/.env`), so a value holding `$(…)`, a
# backtick or a newline ran as the operator. Each line is `KEY=VALUE` (or `export KEY=VALUE`), a
# comment or blank. The value is taken literally: one pair of surrounding quotes is removed, and
# an unquoted value ends at ` #`, as Docker Compose reads the same file. Nothing is expanded, so a
# value is written out in full (`k2:<base64>`, never `k2:$(openssl …)`). Only the settings this
# script reads are exported (PMOS_*, HF_TOKEN and the proxy settings); Compose reads the whole
# file itself through --env-file. Any other kind of line stops the script.
load_env() {
  local line key value n=0
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line=${line%$'\r'}
    [[ "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue
    if [[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
      key=${BASH_REMATCH[2]}
      value=${BASH_REMATCH[3]}
    else
      say "deploy/.env line $n isn't KEY=VALUE, a comment or blank: fix it (nothing in it is run as shell)" >&2
      exit 2
    fi
    case "$key" in
      PMOS_* | HF_TOKEN | HTTPS_PROXY | HTTP_PROXY | NO_PROXY | https_proxy | http_proxy | no_proxy) ;;
      *) continue ;;
    esac
    if [[ "$value" =~ ^\"([^\"]*)\"([[:space:]]+#.*)?[[:space:]]*$ ||
      "$value" =~ ^\'([^\']*)\'([[:space:]]+#.*)?[[:space:]]*$ ]]; then
      value=${BASH_REMATCH[1]}
    else
      value=${value%%[[:space:]]#*}
      value=${value%"${value##*[![:space:]]}"}
    fi
    export "$key=$value"
  done <"$ENV"
}
load_env
row() { printf '  %-12s %-6s %s\n' "$1" "$2" "$3"; }

# The console's sign-in settings. The console checks them too; this says so before anything
# starts (docs/console.md, Sign-in).
console_checks() {
  local proxy_secret="${PMOS_CONSOLE_PROXY_SECRET:-}"
  if [ "${PMOS_CONSOLE_TRUST_PROXY:-0}" = 1 ] && [ ${#proxy_secret} -lt 32 ]; then
    echo "PMOS_CONSOLE_TRUST_PROXY=1 needs PMOS_CONSOLE_PROXY_SECRET (at least 32 characters) in" >&2
    echo "deploy/.env: run deploy/setup.sh to generate it, and set the reverse proxy to send it in" >&2
    echo "X-Pmos-Proxy-Secret (docs/console.md, Sign-in)." >&2
    return 1
  fi
  if [ -n "${PMOS_CONSOLE_DEV_USER:-}" ]; then
    echo "PMOS_CONSOLE_DEV_USER needs a loopback bind, and the console container listens on" >&2
    echo "0.0.0.0: clear it and use PMOS_CONSOLE_TRUST_PROXY=1 (docs/console.md, Sign-in)." >&2
    return 1
  fi
}

# A real value in deploy/.env: set, and not the `generated` placeholder setup.sh fills in.
is_set() { [ -n "${!1:-}" ] && [ "${!1}" != generated ]; }

# User assertions (docs/user-assertion.md, Modes), checked before anything (re)creates the
# runtime or the tool server: `up`, `add-bot`, and the `up` after a `restore`. The mode lives in
# deploy/.env (setup.sh writes `require`), never in one command's environment, so every path
# starts them the same way. With a web or console token set, the services themselves refuse to
# start in `off` or `verify`; this says so first, and that each set client has its keys, so
# nothing is half-configured. The development override (PMOS_ASSERTION_INSECURE_OFF) is for
# fake-data development stacks only: compose.yaml doesn't pass it, so it is refused here too.
assertion_checks() {
  local mode="${PMOS_ASSERTION_MODE:-}" person=() k
  for k in PMOS_RT_WEB_TOKEN PMOS_TS_WEB_TOKEN PMOS_RT_CONSOLE_TOKEN PMOS_CONSOLE_TS_TOKEN; do
    if is_set "$k"; then person+=("$k"); fi
  done
  case "$mode" in
    "" | off | verify | require) ;;
    *) say "PMOS_ASSERTION_MODE=$mode in deploy/.env: use require (docs/user-assertion.md)" >&2; return 1 ;;
  esac
  if [ ${#person[@]} -gt 0 ] && [ -n "$mode" ] && [ "$mode" != require ]; then
    if [ -n "${PMOS_ASSERTION_INSECURE_OFF:-}" ]; then
      say "PMOS_ASSERTION_INSECURE_OFF is set in deploy/.env: that override is for fake-data" >&2
      say "development stacks only, and this deployment doesn't pass it to the services." >&2
    fi
    say "PMOS_ASSERTION_MODE=$mode in deploy/.env, with ${person[*]} set: the runtime and the" >&2
    say "tool server refuse to start like this. Set PMOS_ASSERTION_MODE=require in deploy/.env" >&2
    say "(docs/user-assertion.md, Modes)." >&2
    return 1
  fi
  local pair effective
  for pair in PMOS_RT_WEB_TOKEN:PMOS_AK_WEB_BOTS PMOS_TS_WEB_TOKEN:PMOS_AK_WEB_TOOLSERVER \
    PMOS_RT_CONSOLE_TOKEN:PMOS_AK_CONSOLE_BOTS PMOS_CONSOLE_TS_TOKEN:PMOS_AK_CONSOLE_TOOLSERVER; do
    if is_set "${pair%%:*}" && ! is_set "${pair##*:}"; then
      say "${pair%%:*} is set but ${pair##*:} isn't: run deploy/setup.sh again to generate it" >&2
      return 1
    fi
  done
  if [ ${#person[@]} -gt 0 ]; then
    effective=${mode:-require}
  else
    effective=${mode:-off}
  fi
  say "user assertions: $effective"
}

# Everything a client needs before its profile starts: `up --web` or `up --console`.
client_settings() { # web|console
  local k missing=()
  case "$1" in
    web) set -- PMOS_RT_WEB_TOKEN PMOS_TS_WEB_TOKEN PMOS_AK_WEB_BOTS PMOS_AK_WEB_TOOLSERVER ;;
    console) set -- PMOS_RT_CONSOLE_TOKEN PMOS_CONSOLE_TS_TOKEN PMOS_AK_CONSOLE_BOTS PMOS_AK_CONSOLE_TOOLSERVER ;;
  esac
  for k in "$@"; do is_set "$k" || missing+=("$k"); done
  if [ ${#missing[@]} -gt 0 ]; then
    say "not set in deploy/.env: ${missing[*]}. Run deploy/setup.sh again to generate them." >&2
    return 1
  fi
}

# An IPv4 address as a number; nothing for anything else.
ipv4_number() {
  local IFS=. a b c d
  read -r a b c d <<<"$1"
  for o in "$a" "$b" "$c" "$d"; do
    [[ "$o" =~ ^[0-9]{1,3}$ ]] && [ "$o" -le 255 ] || return 1
  done
  echo $(((a << 24) | (b << 16) | (c << 8) | d))
}

# Is the IPv4 address $1 inside the IPv4 subnet $2 (a.b.c.d/n)?
ipv4_in_subnet() {
  local ip net bits mask
  ip=$(ipv4_number "$1") || return 1
  net=$(ipv4_number "${2%/*}") || return 1
  bits=${2#*/}
  [[ "$bits" =~ ^[0-9]{1,2}$ ]] && [ "$bits" -le 32 ] || return 1
  mask=$(((0xffffffff << (32 - bits)) & 0xffffffff))
  [ $((ip & mask)) = $((net & mask)) ]
}

# Password sign-in counts refused attempts per browser address (docs/password-sign-in.md,
# "Behind the deploy kit's reverse proxy"). The web app listens on 0.0.0.0 in its container and
# the reverse proxy on this host reaches it through the published port, so every request
# arrives from the `pmos` network's gateway, which deploy/compose.yaml pins
# (PMOS_NETWORK_GATEWAY, in PMOS_NETWORK_SUBNET; the re-check of eb24d28, M1). pmos-web refuses
# to start unless it is told that address (PMOS_WEB_TRUSTED_PROXIES) and has an https:// public
# URL. This refuses, with the exact fix, before anything starts: a blank setting; a network
# made before its gateway was pinned (its real gateway isn't PMOS_NETWORK_GATEWAY); and a
# trusted address that is neither the real gateway nor inside the pinned subnet, which would
# make pmos-web refuse every browser. An address inside the subnet (a proxy in a container on
# the pmos network) needs PMOS_WEB_TRUST_PROXY_IN_NETWORK=1 and is warned about every time
# (the gate review of 04c175f, GL4): Docker hands those addresses out.
password_web_checks() {
  [ "${PMOS_WEB_PASSWORD_LOGIN:-0}" = 1 ] || return 0
  local bad=0 real want subnet entry
  want=${PMOS_NETWORK_GATEWAY:-10.201.77.1}
  subnet=${PMOS_NETWORK_SUBNET:-10.201.77.0/24}
  real=$(docker network inspect pmos_pmos --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}' 2>/dev/null || true)
  if [ -n "$real" ] && [ "$real" != "$want" ]; then
    {
      say "The pmos network's gateway is $real, but deploy/.env pins PMOS_NETWORK_GATEWAY=$want"
      say "(PMOS_NETWORK_SUBNET=$subnet): the network was made before its address was pinned, or"
      say "with other settings. Re-create it, then start again:"
      say "  deploy/pmos-admin down && deploy/pmos-admin up --web"
    } >&2
    bad=1
  fi
  [ -n "$real" ] || real=$want
  if [ -z "${PMOS_WEB_TRUSTED_PROXIES:-}" ]; then
    {
      say "PMOS_WEB_TRUSTED_PROXIES is blank in deploy/.env. With password sign-in on, the web app"
      say "must know the address the reverse proxy reaches it from, or every browser would share"
      say "one limit on refused sign-ins (and pmos-web refuses to start)."
      say "The reverse proxy on this host reaches it from the pmos network's gateway. Set:"
      say "  PMOS_WEB_TRUSTED_PROXIES=$real"
      say "  (the gateway is pinned in deploy/.env, PMOS_NETWORK_GATEWAY; check it with:"
      say "   docker network inspect pmos_pmos --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}')"
      say "A reverse proxy in a container on the pmos network instead: set its container address."
    } >&2
    bad=1
  else
    local list=()
    IFS=, read -ra list <<<"$PMOS_WEB_TRUSTED_PROXIES"
    for entry in "${list[@]}"; do
      entry=${entry//[[:space:]]/}
      [ -n "$entry" ] || continue
      [ "$entry" = "$real" ] && continue
      # The gate review of 04c175f (GL4): only the gateway by default. An address inside the
      # subnet (a proxy in a container on the pmos network) is assigned by Docker and can be
      # handed to another container after a restart, which would then be believed about its
      # X-Forwarded-For: it needs PMOS_WEB_TRUST_PROXY_IN_NETWORK=1, and a warning every time.
      if ipv4_in_subnet "$entry" "$subnet" && [ "${PMOS_WEB_TRUST_PROXY_IN_NETWORK:-0}" = 1 ]; then
        {
          say "WARNING: PMOS_WEB_TRUSTED_PROXIES names $entry, an address inside the pmos network"
          say "($subnet), trusted because PMOS_WEB_TRUST_PROXY_IN_NETWORK=1. Docker assigns those"
          say "addresses: pin the proxy container's address (ipv4_address in compose), or any"
          say "container that later gets $entry is believed about which browser it speaks for."
        } >&2
        continue
      fi
      if ipv4_in_subnet "$entry" "$subnet"; then
        {
          say "PMOS_WEB_TRUSTED_PROXIES names $entry, an address inside the pmos network ($subnet)."
          say "Only the network's gateway, $real, is trusted by default: Docker assigns the other"
          say "addresses, and whichever container holds $entry would be believed about which"
          say "browser it speaks for. A reverse proxy on this host reaches the web app from the"
          say "gateway; set:"
          say "  PMOS_WEB_TRUSTED_PROXIES=$real"
          say "A reverse proxy in a container on the pmos network with a pinned address: also set"
          say "  PMOS_WEB_TRUST_PROXY_IN_NETWORK=1"
        } >&2
        bad=1
      else
        {
          say "PMOS_WEB_TRUSTED_PROXIES names $entry, but the reverse proxy on this host reaches the"
          say "web app from the pmos network's gateway, $real. pmos-web would refuse every browser"
          say "(403 proxy_not_trusted). Set:"
          say "  PMOS_WEB_TRUSTED_PROXIES=$real"
          say "(A proxy in a container on the pmos network has an address inside $subnet.)"
        } >&2
        bad=1
      fi
    done
  fi
  case "${PMOS_WEB_PUBLIC_URL:-}" in
    https://*) ;;
    *)
      say "PMOS_WEB_PUBLIC_URL must be the web app's https:// address with password sign-in on" >&2
      say "(passwords and codes never cross the network in the clear)." >&2
      bad=1
      ;;
  esac
  return $bad
}

# Is the web app's Entra sign-in fully set in deploy/.env? (pmos-web itself refuses a partial
# one at start-up, naming what is missing.)
entra_configured() {
  [ -n "${PMOS_WEB_ENTRA_TENANT_ID:-}" ] && [ -n "${PMOS_WEB_ENTRA_CLIENT_ID:-}" ] &&
    [ -n "${PMOS_WEB_ENTRA_CLIENT_SECRET:-}" ] && [ -n "${PMOS_WEB_PUBLIC_URL:-}" ]
}

profiles() {
  local p=()
  if [ -n "${PMOS_SLACK_APP_TOKEN:-}" ] && [ -n "${PMOS_SLACK_BOT_TOKEN:-}" ]; then
    p+=(--profile slack)
  fi
  for arg in "$@"; do
    case "$arg" in
      --models) p+=(--profile models) ;;
      --console) p+=(--profile console) ;;
      --web)
        if [ "${PMOS_WEB_ENABLE_DEV_LOGIN_CLOSED_TEST_NETWORK_ONLY:-0}" != 1 ] && ! entra_configured &&
          [ "${PMOS_WEB_PASSWORD_LOGIN:-0}" != 1 ]; then
          {
            echo "the web app is off: it needs Entra sign-in (PMOS_WEB_ENTRA_TENANT_ID,"
            echo "PMOS_WEB_ENTRA_CLIENT_ID, PMOS_WEB_ENTRA_CLIENT_SECRET and PMOS_WEB_PUBLIC_URL in"
            echo "deploy/.env; docs/entra-sign-in.md), or password sign-in (PMOS_WEB_PASSWORD_LOGIN=1;"
            echo "docs/password-sign-in.md). Or, on a closed test network only, set"
            echo "PMOS_WEB_ENABLE_DEV_LOGIN_CLOSED_TEST_NETWORK_ONLY=1 for DEVELOPMENT sign-in"
            echo "(anyone who can reach it signs in as any team member; docs/web-app-running.md)."
          } >&2
          exit 2
        fi
        p+=(--profile web) ;;
      --bringup) p+=(--profile bringup) ;;
      *) say "unknown option $arg" >&2; exit 2 ;;
    esac
  done
  [ ${#p[@]} -eq 0 ] || printf '%s\n' "${p[@]}"
}

# A call to the tool server's internal API as the orchestrator.
internal() { # method path [json]
  curl -fsS --noproxy '*' -X "$1" "http://127.0.0.1:8710$2" \
    -H "Authorization: Bearer $PMOS_SERVICE_TOKEN" -H 'content-type: application/json' \
    ${3:+-d "$3"}
}

# The `pmos` CLI in the image, in the content checkout, as the checkout's owner.
pmos_cli() {
  docker run --rm --user "${PMOS_UID:-10001}:${PMOS_GID:-10001}" \
    -v "$PMOS_CONTENT_CHECKOUT:/srv/content-repo" -w /srv/content-repo \
    "pmos:${PMOS_VERSION:-local}" "$@"
}

# --- The eval stack (deploy/compose.evals.yaml) ---------------------------------------------
# A separate, short-lived tool server, runtime and workers on a checkout's content, sharing only
# the live gateway (models) and docs server. Fresh tokens every time; removed afterwards.
EVAL_DIR=""
evals_compose() {
  docker compose --project-directory "$DEPLOY" -f "$DEPLOY/compose.evals.yaml" --env-file "$ENV" "$@"
}
eval_stack_up() { # checkout
  local checkout
  checkout=$(cd "$1" && pwd)
  [ -f "$checkout/content/tools.yaml" ] || { say "$checkout has no content/tools.yaml" >&2; exit 2; }
  if ! curl -fsS --noproxy '*' -m 5 http://127.0.0.1:8740/healthz >/dev/null 2>&1; then
    say "the gateway isn't running: start the stack first (deploy/pmos-admin up --models)" >&2
    exit 2
  fi
  EVAL_DIR=$(mktemp -d "${TMPDIR:-/tmp}/pmos-evals.XXXXXX")
  chmod 755 "$EVAL_DIR"
  # The checkout's content, plus the people the fake fixtures expect: `evals` (U0EVALS), whom
  # the benchmark tasks are requested by, and their teammates ben (U0BEN) and cy (U0CY), so
  # the fake channels' audiences mean what the tasks say (crates/toolserver/src/connectors/fake.rs),
  # and `eval-admin` (U0EVALADM, in no fake channel): the user database always needs an active
  # admin. They are the tool server's seed (PMOS_USERS_SEED, compose.evals.yaml), a file beside
  # the content, never in it; each gets a personal bot in this copy of the content (pm-evals is
  # the one the tasks use). Only this copy is changed.
  # -P: a symbolic link in the checkout is copied as a link, never followed on this machine.
  cp -RP "$checkout/content" "$EVAL_DIR/content"
  mkdir -p "$EVAL_DIR/baseline" "$EVAL_DIR/out"
  local who
  printf 'members:\n' >"$EVAL_DIR/users.seed.yaml"
  for who in evals:U0EVALS:pm ben:U0BEN:pm cy:U0CY:pm eval-admin:U0EVALADM:pm,admin; do
    local handle=${who%%:*} rest=${who#*:}
    printf '  - {handle: %s, slack-id: %s, roles: [%s]}\n' "$handle" "${rest%%:*}" "${rest#*:}" >>"$EVAL_DIR/users.seed.yaml"
    docker run --rm --user "${PMOS_UID:-10001}:${PMOS_GID:-10001}" -v "$EVAL_DIR/content:/srv/content" \
      "pmos:${PMOS_VERSION:-local}" pmos bot add-personal --root /srv/content --handle "$handle" >/dev/null
  done
  chown -R "${PMOS_UID:-10001}:${PMOS_GID:-10001}" "$EVAL_DIR" 2>/dev/null || true
  export PMOS_EVAL_USERS_SEED="$EVAL_DIR/users.seed.yaml"
  export PMOS_EVAL_CONTENT="$EVAL_DIR/content" PMOS_EVAL_CHECKOUT="$checkout" PMOS_EVAL_BASELINE="$EVAL_DIR/baseline" PMOS_EVAL_OUT="$EVAL_DIR/out"
  for v in SERVICE_TOKEN BOT_TOKEN RT_EVALS RT_CONSOLE RT_DOCS RT_PERSONAL; do
    export "PMOS_EVAL_$v=$(openssl rand -hex 24)"
  done
  trap eval_stack_down EXIT
  evals_compose up -d --wait toolserver bots worker-docs worker-personal >/dev/null
}
eval_stack_down() {
  evals_compose --profile runner down -v --remove-orphans >/dev/null 2>&1 || true
  [ -n "$EVAL_DIR" ] && rm -rf "$EVAL_DIR"
}
evals_runner() { evals_compose --profile runner run --rm -T runner "$@"; }

# Does $1 consist only of the characters listed one by one in $2 (no ranges, so no locale can
# widen them)? An empty $1 does.
only_chars() { case "$1" in *[!$2]*) return 1 ;; esac; }
ENV_KEY_CHARS=ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_
# What pmos-admin may write as a value into deploy/.env (tokens, `key=token` lists): nothing a
# shell or Compose gives a meaning to (no `$`, quote, backslash, space, `#`, `~` or newline).
ENV_VALUE_CHARS='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_.,:=/+-'

# Replace or append KEY=VALUE in deploy/.env. A key or value with any other character is
# refused (exit 2) before the file is touched.
set_env() {
  local tmp
  if [ -z "$1" ] || ! only_chars "$1" "$ENV_KEY_CHARS" || ! only_chars "$2" "$ENV_VALUE_CHARS"; then
    say "refusing to write $(printf '%q' "$1") to deploy/.env: only plain characters may go there" >&2
    exit 2
  fi
  tmp=$(mktemp)
  if grep -qE "^$1=" "$ENV"; then
    awk -v k="$1" -v v="$2" -F= 'BEGIN{OFS="="} $1==k{print k, v; next} {print}' "$ENV" >"$tmp"
  else
    cat "$ENV" >"$tmp"
    printf '%s=%s\n' "$1" "$2" >>"$tmp"
  fi
  cat "$tmp" >"$ENV"
  rm -f "$tmp"
}

# --- Bots: names, tokens, sandboxes and their workers ---------------------------------------
# docs/openshell-any-host-spec.md §3.7 (slice H0).

# PM OS's own rule for a bot name, the same as `valid_name` in crates/contract/src/bots.rs:
# lowercase ASCII letters, digits and single hyphens, not starting or ending with one, 1 to 32
# characters. The letters are listed one by one, so no locale widens them. `add-bot`, `sandbox`,
# `pause` and `resume` check it before the name reaches deploy/.env, a path, a lookup, an
# OpenShell argument or a systemd unit name.
BOT_NAME_CHARS=abcdefghijklmnopqrstuvwxyz0123456789-
valid_bot_name() {
  [ -n "$1" ] && [ ${#1} -le 32 ] && only_chars "$1" "$BOT_NAME_CHARS" || return 1
  case "$1" in -* | *- | *--*) return 1 ;; esac
}
require_bot_name() { # command name
  valid_bot_name "$2" && return 0
  say "pmos-admin $1: $(printf '%q' "$2") isn't a bot name (lowercase letters, digits and single hyphens, at most 32 characters)" >&2
  exit 2
}

# The value for KEY in a `key=value,key=value` list (PMOS_RT_WORKER_TOKENS, PMOS_GW_BOT_TOKENS),
# by an exact match of the whole key: the key is never a pattern.
list_value() { # list key
  tr ',' '\n' <<<"$1" | LIST_KEY=$2 awk -F= '$1 == ENVIRON["LIST_KEY"] { print substr($0, length($1) + 2); exit }'
}

# The worker unit (deploy/systemd/pmos-worker@.service), installed as a user unit of the user
# whose OpenShell gateway runs (OpenShell's gateway is a systemd user service:
# about/installation.mdx in OpenShell's docs).
WORKER_UNIT_TEMPLATE="$DEPLOY/systemd/pmos-worker@.service"
user_unit_dir() { printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"; }
# The instance's unit name: systemd-escape turns `pm-ana` into `pm\x2dana`; the unit reads the
# name back with %I.
worker_unit() { # bot
  local escaped
  escaped=$(systemd-escape -- "$1")
  printf 'pmos-worker@%s.service\n' "$escaped"
}
# Only the path of `openshell` on the template's ExecStart line is replaced, with the absolute
# path on this PATH; a path with any character outside a plain set (a `%` would be a systemd
# specifier, a space would split the command) is refused.
PATH_CHARS='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_./+-'
install_worker_unit() {
  local openshell dir
  openshell=$(command -v openshell)
  case "$openshell" in /*) ;; *) say "openshell isn't an absolute path on PATH ($openshell)" >&2; exit 1 ;; esac
  if ! only_chars "$openshell" "$PATH_CHARS"; then
    say "the path of openshell, $(printf '%q' "$openshell"), has characters a unit file can't hold" >&2
    exit 1
  fi
  dir=$(user_unit_dir)
  mkdir -p "$dir"
  OPENSHELL_PATH=$openshell awk '
    index($0, "ExecStart=/usr/bin/openshell ") == 1 { print "ExecStart=" ENVIRON["OPENSHELL_PATH"] substr($0, length("ExecStart=/usr/bin/openshell") + 1); next }
    { print }
  ' "$WORKER_UNIT_TEMPLATE" >"$dir/.pmos-worker@.service.new"
  mv "$dir/.pmos-worker@.service.new" "$dir/pmos-worker@.service"
}
# What a worker unit needs before it is installed or started: a user's systemd (not root's) and
# lingering, without which the user's services, OpenShell's gateway included, stop at logout and
# don't start at boot (bot decision D2: "After a reboot, in-flight tasks resume"). The check is
# from OpenShell's and systemd's docs (`loginctl enable-linger`); that it is enough to bring the
# gateway and every worker back after a reboot is check E-5 on a real host.
worker_unit_checks() {
  local me linger
  if [ "$(id -u)" = 0 ]; then
    say "run this as the user whose OpenShell gateway runs, not as root: the worker is that user's systemd unit" >&2
    exit 1
  fi
  for t in systemctl systemd-escape loginctl; do
    command -v "$t" >/dev/null || { say "$t is not installed: the worker runs as a systemd user unit" >&2; exit 1; }
  done
  me=$(id -un)
  linger=$(loginctl show-user "$me" -p Linger --value 2>/dev/null || true)
  if [ "$linger" != yes ]; then
    say "lingering is off for $me: OpenShell's gateway and the bots' workers would stop at logout and" >&2
    say "not start after a reboot. Turn it on once, then run this again:" >&2
    say "  sudo loginctl enable-linger $me" >&2
    exit 1
  fi
}

cmd=${1:-help}
shift || true
case "$cmd" in
  build)
    args=(--build-arg "HTTPS_PROXY=${HTTPS_PROXY:-}" --build-arg "NO_PROXY=${NO_PROXY:-}")
    if [ -n "${HTTPS_PROXY:-}" ]; then args+=(--network host); fi
    if [ -n "${PMOS_BUILD_CA:-}" ]; then args+=(--secret "id=ca,src=$PMOS_BUILD_CA"); fi
    tag=${PMOS_VERSION:-local}
    say "== building pmos:$tag (the Rust services; the first build takes a while)"
    DOCKER_BUILDKIT=1 docker build "${args[@]}" -f "$DEPLOY/Dockerfile" -t "pmos:$tag" "$ROOT"
    say "== building pmos-worker:$tag (the bots' sandbox image)"
    DOCKER_BUILDKIT=1 docker build "${args[@]}" -f "$DEPLOY/Dockerfile.worker" -t "pmos-worker:$tag" "$ROOT"
    ;;

  up)
    for arg in "$@"; do
      if [ "$arg" = --console ]; then
        console_checks || exit 2
        client_settings console || exit 2
      fi
      if [ "$arg" = --web ]; then
        client_settings web || exit 2
        password_web_checks || exit 2
      fi
    done
    # Not a process substitution: a refusal in `profiles` (an unknown option, a web app with no
    # sign-in) must stop `up` here, and its exit would be lost in one.
    profile_lines=$(profiles "$@") || exit $?
    prof=()
    [ -z "$profile_lines" ] || mapfile -t prof <<<"$profile_lines"
    assertion_checks || exit 2
    if [ -z "${PMOS_SLACK_APP_TOKEN:-}" ] || [ -z "${PMOS_SLACK_BOT_TOKEN:-}" ]; then
      say "note: the Slack bot is off until PMOS_SLACK_APP_TOKEN and PMOS_SLACK_BOT_TOKEN are set"
    fi
    compose "${prof[@]}" up -d
    say "started; check with: deploy/pmos-admin status"
    ;;

  down)
    compose --profile slack --profile console --profile web --profile models --profile bringup down
    ;;

  status)
    say "== containers"
    compose --profile slack --profile console --profile web --profile models --profile bringup ps \
      --format 'table {{.Service}}\t{{.Status}}'
    say "== readiness"
    check() { # name url
      local body code
      body=$(curl -sS --noproxy '*' -m 5 -w '\n%{http_code}' "$2" 2>/dev/null) || { row "$1" DOWN "no answer from $2"; return; }
      code=${body##*$'\n'}
      body=${body%$'\n'*}
      if [ "$code" = 200 ]; then row "$1" ok "${body:0:90}"; else row "$1" "$code" "${body:0:90}"; fi
      # A readiness warning (the web app's GL3: password requests refused proxy_not_trusted
      # in the last 15 minutes): ready, but every browser behind that proxy is refused.
      if [[ "$body" == *'"warnings":["'* ]]; then
        local w=${body#*\"warnings\":[}
        w=${w%%]*}
        row "$1" WARN "${w//\"/}"
        if [[ "$w" == *untrusted_proxy_refusals* ]]; then
          row "" "" "password sign-ins are refused proxy_not_trusted: PMOS_WEB_TRUSTED_PROXIES must be"
          row "" "" "where the reverse proxy reaches the web app from (docs/password-sign-in.md)"
        fi
      fi
    }
    check toolserver http://127.0.0.1:8710/readyz
    check gateway http://127.0.0.1:8740/readyz
    # G2: the gateway's /readyz says its class and whether the stub model is on.
    gw=$(curl -sS --noproxy '*' -m 5 http://127.0.0.1:8740/readyz 2>/dev/null) || gw=""
    if [[ "$gw" == *'"stub":true'* ]]; then
      row gateway WARN "the STUB model answers every call (PMOS_GATEWAY_STUB=1): set it to 0 once the model servers are up (docs/runbooks/install.md)"
    elif [[ "$gw" == *'"class":"'* && "$gw" != *'"class":"production"'* ]]; then
      row gateway WARN "not a production-class gateway: its eval runs don't count (deploy/gateway.yaml has class: production; docs/gateway.md)"
    fi
    check bots http://127.0.0.1:8750/readyz
    if compose --profile console ps --status running --services 2>/dev/null | grep -qx console; then
      check console http://127.0.0.1:8760/healthz
    fi
    if compose --profile web ps --status running --services 2>/dev/null | grep -qx web; then
      # /readyz: with Entra sign-in on it includes `entra_link`, whether the tool server
      # validates first-link tokens for the same tenant and client id (docs/entra-sign-in.md).
      check web http://127.0.0.1:8770/readyz
    fi
    if compose exec -T docs curl -fsS -m 5 http://127.0.0.1:8730/readyz >/dev/null 2>&1; then
      row docs ok "ready"
    else
      row docs "not" "ready (normal until the first sync finishes; or no docs site set in PMOS_DOCS_BASE_URL)"
    fi
    ;;

  logs)
    [ $# -ge 1 ] || { say "usage: pmos-admin logs <service> [-f]" >&2; exit 2; }
    svc=$1
    shift
    compose --profile slack --profile console --profile web --profile models --profile bringup logs --tail 200 "$@" "$svc"
    ;;

  restart)
    [ $# -eq 1 ] || { say "usage: pmos-admin restart <service>" >&2; exit 2; }
    compose --profile slack --profile console --profile web --profile models --profile bringup restart "$1"
    ;;

  backup)
    dir="$DEPLOY/backups/$(date -u +%Y%m%dT%H%M%SZ)"
    mkdir -p "$dir"
    chmod 700 "$dir"
    for db in toolserver bots docs; do
      say "  dumping pmos_$db"
      compose exec -T postgres pg_dump -U postgres -Fc "pmos_$db" >"$dir/pmos_$db.dump"
    done
    for d in audit usage; do
      if [ -d "$PMOS_STATE_DIR/$d" ]; then tar -C "$PMOS_STATE_DIR" -czf "$dir/$d.tgz" "$d"; fi
    done
    (cd "$dir" && sha256sum ./* >SHA256SUMS)
    say "backup in $dir"
    say "It holds sealed tokens: keep it with deploy/.env's vault key, and both somewhere safe."
    ;;

  restore)
    [ $# -eq 1 ] && [ -d "$1" ] || { say "usage: pmos-admin restore <backup dir>" >&2; exit 2; }
    dir=$(cd "$1" && pwd)
    (cd "$dir" && sha256sum -c --quiet SHA256SUMS) || { say "the backup's checksums don't match; not restoring" >&2; exit 1; }
    # The `up` that follows starts the services from deploy/.env: check now that it will
    # start them with assertions as configured, before anything is stopped.
    assertion_checks || exit 2
    say "This replaces every PM OS database with the backup in $dir."
    read -r -p "Type RESTORE to go on: " answer
    [ "$answer" = RESTORE ] || { say "stopped; nothing changed"; exit 1; }
    compose --profile slack --profile console --profile web --profile bringup stop docs toolserver gateway bots slack console web worker-docs 2>/dev/null || true
    compose up -d postgres
    until compose exec -T postgres pg_isready -U postgres >/dev/null 2>&1; do sleep 1; done
    for db in toolserver bots docs; do
      say "  restoring pmos_$db"
      compose exec -T postgres psql -U postgres -v ON_ERROR_STOP=1 -q \
        -c "DROP DATABASE IF EXISTS pmos_$db WITH (FORCE)" -c "CREATE DATABASE pmos_$db OWNER pmos_$db"
      compose exec -T postgres pg_restore -U postgres --role="pmos_$db" --no-owner -d "pmos_$db" <"$dir/pmos_$db.dump"
    done
    for d in audit usage; do
      if [ -f "$dir/$d.tgz" ]; then tar -C "$PMOS_STATE_DIR" -xzf "$dir/$d.tgz"; fi
    done
    say "restored; start the services again with: deploy/pmos-admin up"
    ;;

  reindex)
    internal POST /internal/reindex && echo
    ;;

  audit)
    # Read-only: what the tool server's next daily purge would delete (docs/audit-retention.md).
    [ "$*" = "purge --dry-run" ] || { say "usage: pmos-admin audit purge --dry-run (the tool server purges daily itself)" >&2; exit 2; }
    days=${PMOS_AUDIT_RETENTION_DAYS:-90}
    case "$days" in '' | *[!0-9]*) say "PMOS_AUDIT_RETENTION_DAYS=$days isn't a number of days" >&2; exit 2 ;; esac
    [ "$days" -ge 90 ] || { say "PMOS_AUDIT_RETENTION_DAYS=$days is under the 90-day minimum" >&2; exit 2; }
    compose exec -T postgres psql -U postgres -d pmos_toolserver -v ON_ERROR_STOP=1 -At -F ' ' \
      -c "SELECT count(*), coalesce(min(at)::text, '-') FROM audit_events WHERE at < now() - make_interval(days => $days)" |
      { read -r n oldest; say "retention $days days: $n events would be deleted (oldest: $oldest); nothing was deleted"; }
    ;;

  revoke)
    [ $# -eq 2 ] || { say "usage: pmos-admin revoke <handle> <atlassian|slack|github>" >&2; exit 2; }
    internal DELETE "/internal/credentials/$1/$2" && say "revoked $2 for $1"
    ;;

  users)
    # The user database's host commands (docs/runbooks/users.md): `pmos-toolserver users …` in a
    # one-off tool server container, with the database's own access. The OS user who ran it is
    # passed as PMOS_HOST_USER and recorded with every change; the tool server refuses to run
    # without it. A one-off container starts no service, so this needs no assertion check
    # (that is for `up`, `add-bot` and `restore`), and break glass works whatever the mode.
    users_usage() {
      say "usage: pmos-admin users <bootstrap-admin|grant-admin|revoke-admin|set-entra|unset-entra|set-sign-in-name|set-atlassian-email|deactivate|reactivate|pilot-exception|password-setup|import|export|list> …" >&2
      exit 2
    }
    [ $# -ge 1 ] || users_usage
    case "$1" in
      bootstrap-admin | grant-admin | revoke-admin | set-entra | unset-entra | set-sign-in-name | \
        set-atlassian-email | deactivate | reactivate | pilot-exception | password-setup | import | \
        export | list) ;;
      *) users_usage ;;
    esac
    host_user=${SUDO_USER:-$(id -un)}
    if ! [[ "$host_user" =~ ^[a-z_][a-z0-9_.-]{0,31}$ ]]; then
      say "the OS user \"$host_user\" can't be recorded (it must match ^[a-z_][a-z0-9_.-]{0,31}\$): run this as a named user" >&2
      exit 2
    fi
    run=(run --rm --no-deps -e "PMOS_HOST_USER=$host_user")
    # --oid needs the tenant: the web app's.
    if [ -n "${PMOS_WEB_ENTRA_TENANT_ID:-}" ]; then
      run+=(-e "PMOS_ENTRA_TENANT_ID=$PMOS_WEB_ENTRA_TENANT_ID")
    fi
    # A terminal only when there is one (`import --allow-admins` asks on it; `export > f` has none).
    if ! [ -t 0 ] || ! [ -t 1 ]; then run+=(-T); fi
    if [ "$1" = import ]; then
      # The file the operator names (an old team.yaml, normally read from the content checkout
      # at a reviewed commit before the pull request that deletes it) is mounted read-only into
      # the one-off container under a neutral name; never a URL.
      shift
      from=""
      args=(import)
      while [ $# -gt 0 ]; do
        case "$1" in
          --from) [ $# -ge 2 ] || users_usage; from=$2; shift 2 ;;
          *) args+=("$1"); shift ;;
        esac
      done
      [ -n "$from" ] || { say "usage: pmos-admin users import --from <file> [--commit <sha>] [--allow-admins | --bootstrap] [--apply]" >&2; exit 2; }
      [ -f "$from" ] || { say "no file $from" >&2; exit 2; }
      from="$(cd "$(dirname "$from")" && pwd)/$(basename "$from")"
      case "$from" in *:*) say "the path to import can't contain ':'" >&2; exit 2 ;; esac
      run+=(-v "$from:/run/pmos-import/members.yaml:ro")
      args+=(--from /run/pmos-import/members.yaml)
    else
      args=("$@")
    fi
    compose "${run[@]}" toolserver pmos-toolserver users "${args[@]}"
    ;;

  ledger)
    since=7d
    export=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --since) since=$2; shift 2 ;;
        --export) export=1; shift ;;
        *) say "usage: pmos-admin ledger [--since 7d|24h|<date>] [--export]" >&2; exit 2 ;;
      esac
    done
    case "$since" in
      *d) from=$(date -u -d "-${since%d} days" +%Y-%m-%dT%H:%M:%SZ) ;;
      *h) from=$(date -u -d "-${since%h} hours" +%Y-%m-%dT%H:%M:%SZ) ;;
      *) from=$(date -u -d "$since" +%Y-%m-%dT%H:%M:%SZ) ;;
    esac
    if [ "$export" = 1 ]; then
      # JSON lines, one ledger row each (labels and metadata only; no message text).
      internal GET "/internal/ledger?since=$from&limit=1000" | python3 -c 'import json,sys
for r in json.load(sys.stdin)["rows"]: print(json.dumps(r))'
      exit 0
    fi
    internal GET "/internal/ledger/summary?since=$from" | python3 -c '
import json, sys
s = json.load(sys.stdin)
print(f"drafts since {s.get("since", "?")}: {s["rows"]}, labelled {s["label_coverage"]:.0%} (phase 0 gate: 95%)")
print(f"  {"bot/skill":<18} {"tool":<26} {"n":>4} {"ok":>4} {"edit":>4} {"rej":>4} {"exp":>4} {"med edit":>8}  reasons")
for g in s["groups"]:
    c = g["counts"]
    med = g.get("median_edit_distance")
    reasons = ", ".join(f"{k} {v}" for k, v in sorted(g.get("reasons", {}).items()) if v)
    who = g.get("bot") or g.get("skill") or "?"
    print(f"  {who:<18} {g["tool"]:<26} {g["rows"]:>4} {c.get("approved",0):>4} {c.get("edited",0):>4} {c.get("rejected",0):>4} {c.get("expired",0):>4} {(f"{med:.0%}" if med is not None else "-"):>8}  {reasons}")
'
    ;;

  add-bot)
    [ $# -eq 1 ] || { say "usage: pmos-admin add-bot <bot>" >&2; exit 2; }
    bot=$1
    # Checked before anything: the name goes into deploy/.env (`worker-<bot>=<token>`), where a
    # comma or `=` would add or override another bot's token.
    require_bot_name add-bot "$bot"
    if [ "$bot" = docs ]; then
      say "the Docs bot's tokens are built in (PMOS_RT_DOCS_WORKER_TOKEN)"
      exit 0
    fi
    if [ -n "$(list_value "${PMOS_RT_WORKER_TOKENS:-}" "worker-$bot")" ]; then
      say "$bot already has tokens"
      exit 0
    fi
    # The runtime is recreated with deploy/.env as it is, assertions included: the web app and
    # the console may be running against it. Checked before anything is written.
    assertion_checks || exit 2
    rt=$(openssl rand -hex 24)
    gw=$(openssl rand -hex 24)
    set_env PMOS_RT_WORKER_TOKENS "${PMOS_RT_WORKER_TOKENS:+$PMOS_RT_WORKER_TOKENS,}worker-$bot=$rt"
    set_env PMOS_GW_BOT_TOKENS "${PMOS_GW_BOT_TOKENS:+$PMOS_GW_BOT_TOKENS,}bot-$bot=$gw"
    # Read deploy/.env again: compose prefers this process's environment over --env-file, so
    # the values read at the top would hide the new tokens.
    load_env
    compose up -d bots gateway
    say "tokens added for $bot; the runtime and gateway were restarted with them."
    say "next: deploy/pmos-admin sandbox $bot"
    ;;

  sandbox)
    # What each step rests on (slice H0; docs/openshell-any-host-spec.md §3.7). Nothing here
    # has run on a real OpenShell yet; the acceptance run (§6) checks each "verify" below.
    # - `sandbox create --from <image>`: OpenShell's sandbox page documents `--from` with "an
    #   explicit OCI image reference" built and tagged "with the container engine used by your
    #   local gateway" (the earlier `--image` isn't documented). Verify on a real host: that it
    #   takes the local tag pmos-worker:<version> without a registry.
    # - The worker runs as the systemd user unit deploy/systemd/pmos-worker@.service (no more
    #   `&` from the operator's shell, which died at logout and never came back after a reboot).
    #   Verify on a real host: that `sandbox exec` stays in the foreground for the worker's life,
    #   and the name of OpenShell's gateway unit (see the unit file).
    # - `provider create`, `--policy`, `--provider` and `--upload`: as in docs/sandbox-policies.md.
    sandbox_usage() { say "usage: pmos-admin sandbox <bot> [--dry-run]" >&2; exit 2; }
    dry=0
    names=()
    for a in "$@"; do
      case "$a" in
        --dry-run) dry=1 ;;
        -*) sandbox_usage ;;
        *) names+=("$a") ;;
      esac
    done
    [ ${#names[@]} -eq 1 ] || sandbox_usage
    bot=${names[0]}
    require_bot_name sandbox "$bot"
    [ "$dry" = 1 ] || command -v openshell >/dev/null || { say "openshell is not installed" >&2; exit 1; }
    spec="$PMOS_CONTENT_CHECKOUT/policies/bots/$bot.sandbox.yaml"
    policy="$PMOS_CONTENT_CHECKOUT/policies/bots/$bot.yaml"
    [ -f "$spec" ] && [ -f "$policy" ] || { say "no generated policy for $bot in the content checkout; run pmos policy generate and merge it" >&2; exit 1; }
    if [ "$bot" = docs ]; then
      rt=$PMOS_RT_DOCS_WORKER_TOKEN
      gw=$PMOS_GW_DOCS_BOT_TOKEN
    else
      rt=$(list_value "${PMOS_RT_WORKER_TOKENS:-}" "worker-$bot")
      gw=$(list_value "${PMOS_GW_BOT_TOKENS:-}" "bot-$bot")
      [ -n "$rt" ] && [ -n "$gw" ] || { say "run deploy/pmos-admin add-bot $bot first" >&2; exit 1; }
    fi
    [ "$dry" = 1 ] || worker_unit_checks
    sandbox="pmos-$bot"
    unit=$(worker_unit "$bot")
    # Uploads come from the generated spec: `from` is relative to the content root.
    uploads=()
    while read -r from to; do
      uploads+=(--upload "$PMOS_CONTENT_CHECKOUT/content/$from:$to")
    done < <(awk '/^  - from: /{f=$3} /^    to: /{print f, $2}' "$spec")
    create=(sandbox create --name "$sandbox" --from "pmos-worker:${PMOS_VERSION:-local}" --policy "$policy"
      --provider "$sandbox-gateway" --provider "$sandbox-worker" "${uploads[@]}")
    if [ "$dry" = 1 ]; then
      # What would run; the tokens are never printed.
      say "openshell provider create --name $sandbox-gateway --type pmos-gateway --credential PMOS_GATEWAY_TOKEN  (the token from deploy/.env)"
      say "openshell provider create --name $sandbox-worker --type pmos-worker --credential PMOS_WORKER_TOKEN  (the token from deploy/.env)"
      say "openshell ${create[*]}"
      say "install $WORKER_UNIT_TEMPLATE as $(user_unit_dir)/pmos-worker@.service"
      say "systemctl --user daemon-reload"
      say "systemctl --user enable --now $unit"
      exit 0
    fi
    PMOS_GATEWAY_TOKEN=$gw openshell provider create --name "$sandbox-gateway" --type pmos-gateway --credential PMOS_GATEWAY_TOKEN
    PMOS_WORKER_TOKEN=$rt openshell provider create --name "$sandbox-worker" --type pmos-worker --credential PMOS_WORKER_TOKEN
    openshell "${create[@]}"
    install_worker_unit
    systemctl --user daemon-reload
    systemctl --user enable --now "$unit"
    say "sandbox $sandbox created; its worker runs as the user unit $unit"
    say "check it with: systemctl --user status '$unit'"
    ;;

  pause)
    # The unit is disabled as well as stopped, so a paused bot stays paused after a reboot.
    [ $# -eq 1 ] || { say "usage: pmos-admin pause <bot>" >&2; exit 2; }
    require_bot_name pause "$1"
    if command -v systemctl >/dev/null && command -v systemd-escape >/dev/null &&
      [ -f "$(user_unit_dir)/pmos-worker@.service" ]; then
      unit=$(worker_unit "$1")
      # A pause is the first step of an incident (docs/runbooks/incidents.md): if the unit can't
      # be stopped, say so and stop the sandbox all the same.
      systemctl --user disable --now "$unit" ||
        say "couldn't stop $unit; stopping the sandbox anyway (check: systemctl --user status '$unit')" >&2
    fi
    openshell sandbox stop -n "pmos-$1"
    say "pmos-$1 stopped; its queued tasks wait (and fail after their retry) until resume"
    ;;

  resume)
    # Also how a sandbox made before the worker unit existed gets one (docs/runbooks/upgrade.md).
    [ $# -eq 1 ] || { say "usage: pmos-admin resume <bot>" >&2; exit 2; }
    require_bot_name resume "$1"
    command -v openshell >/dev/null || { say "openshell is not installed" >&2; exit 1; }
    worker_unit_checks
    unit=$(worker_unit "$1")
    openshell sandbox start -n "pmos-$1"
    install_worker_unit
    systemctl --user daemon-reload
    # A unit that hit its start limit stays failed until this.
    systemctl --user reset-failed "$unit" 2>/dev/null || true
    systemctl --user enable --now "$unit"
    say "pmos-$1 started; its worker runs as the user unit $unit"
    ;;

  lint)
    pmos_cli sh -c 'pmos lint --root content && pmos policy check --root content --policies policies'
    ;;

  pmos)
    pmos_cli pmos "$@"
    ;;

  evals)
    # The benchmarks and load test (docs/evals.md), run in the image on the stack's network.
    # Reports are written to evals/reports in the content checkout; commit them.
    docker run --rm --user "${PMOS_UID:-10001}:${PMOS_GID:-10001}" --network pmos_pmos \
      -v "$PMOS_CONTENT_CHECKOUT:/srv/content-repo" -w /srv/content-repo \
      -e PMOS_BOTS_URL=http://bots.pmos.internal:8750 -e PMOS_EVALS_TOKEN="$PMOS_RT_EVALS_TOKEN" \
      -e PMOS_EVALS_ROOT=evals "pmos:${PMOS_VERSION:-local}" pmos-evals "$@"
    ;;

  evals-run|evals-stack)
    # evals-run: `pmos-evals run <args>`; evals-stack: `pmos-evals <args>` (judge calibrate, …).
    checkout=$PMOS_CONTENT_CHECKOUT
    args=()
    [ "$cmd" = evals-run ] && args+=(run)
    while [ $# -gt 0 ]; do
      case "$1" in
        --checkout) checkout=$2; shift 2 ;;
        *) args+=("$1"); shift ;;
      esac
    done
    eval_stack_up "$checkout"
    evals_runner "${args[@]}"
    if [ "$cmd" = evals-run ]; then
      say "report written under $checkout/evals/reports; commit it so the gate can compare against it"
    fi
    ;;

  evals-gate)
    # The eval gate. --checkout names the tree being measured (CI: the PR's head, in pr/). That
    # tree is data: only git runs on it (diff, archive), and the eval stack's containers, which
    # run this machine's installed images, read its content/, evals/ and deploy/gateway.yaml.
    # Nothing from it is sourced or executed, and the compose file is this script's own.
    base=origin/main
    checkout=$ROOT
    dry=0
    gate_usage() { say "usage: pmos-admin evals-gate [--checkout <dir>] [--base <ref>] [--dry-run]" >&2; exit 2; }
    while [ $# -gt 0 ]; do
      case "$1" in
        --base) [ $# -ge 2 ] || gate_usage; base=$2; shift 2 ;;
        --checkout) [ $# -ge 2 ] || gate_usage; checkout=$2; shift 2 ;;
        --dry-run) dry=1; shift ;;
        *) gate_usage ;;
      esac
    done
    # The base goes to `git diff` and `git archive` as a revision: one that starts with `-` would
    # be read as an option (`--output=<file>`, `--remote=…`).
    case "$base" in -* | '') say "--base must name a revision, not $(printf '%q' "$base")" >&2; exit 2 ;; esac
    [ -d "$checkout" ] || { say "no directory $checkout" >&2; exit 2; }
    checkout=$(cd "$checkout" && pwd)
    if [ "$dry" = 1 ]; then
      # What the gate would use, without starting anything (scripts and CI check the parse).
      say "checkout=$checkout"
      say "base=$base"
      exit 0
    fi
    changed=$(git -C "$checkout" diff --name-only "$base"...HEAD)
    eval_stack_up "$checkout"
    mapfile -t categories < <(printf '%s\n' "$changed" | evals_runner affected --content content)
    if [ ${#categories[@]} -eq 0 ]; then
      say "The eval gate: no benchmark category is affected by this change."
      exit 0
    fi
    # The baseline: the base branch's committed reports, unpacked where the runner can read them.
    git -C "$checkout" archive "$base" evals/reports | tar -x -C "$PMOS_EVAL_BASELINE"
    worst=0
    for c in "${categories[@]}"; do
      code=0
      evals_runner gate --category "$c" --baseline-reports /srv/baseline/evals/reports \
        --reports-dir /srv/out || code=$?
      echo
      [ "$code" -gt "$worst" ] && worst=$code
    done
    exit "$worst"
    ;;

  smoke)
    # One Docs-bot question through the whole stack, as the Slack bot would send it.
    [ $# -eq 1 ] || { say "usage: pmos-admin smoke <handle of an active user>" >&2; exit 2; }
    auth=(-H "Authorization: Bearer $PMOS_RT_SLACK_TOKEN" -H "X-Pmos-User: $1")
    body=$(printf '{"bot":"docs","requested_by":"%s","text":"What does the docs site say about getting started?","source":"slack","slack":{"channel":"smoke","thread_ts":"0.0"}}' "$1")
    task=$(curl -sS --noproxy '*' -X POST http://127.0.0.1:8750/v1/tasks "${auth[@]}" -H 'content-type: application/json' -d "$body")
    id=$(sed -n 's/.*"id":"\(tsk_[0-9a-f]*\)".*/\1/p' <<<"$task")
    [ -n "$id" ] || { say "the runtime refused the task: $task" >&2; exit 1; }
    say "task $id queued; waiting up to 3 minutes for a worker"
    status=queued
    for _ in $(seq 1 90); do
      status=$(curl -sS --noproxy '*' "http://127.0.0.1:8750/v1/tasks/$id" "${auth[@]}" | sed -n 's/.*"status":"\([a-z_]*\)".*/\1/p')
      case "$status" in done|failed|cancelled|needs_approval) break ;; esac
      sleep 2
    done
    curl -sS --noproxy '*' "http://127.0.0.1:8750/v1/tasks/$id/events" "${auth[@]}" | tr '{' '\n' | sed -n 's/.*"kind":"\([a-z_]*\)".*"text":"\([^"]*\)".*/  \1: \2/p'
    echo
    if [ "$status" = done ]; then say "smoke test passed"; else say "smoke test ended as: $status" >&2; exit 1; fi
    ;;

  help|-h|--help)
    awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
    ;;

  *)
    say "unknown command $cmd; see deploy/pmos-admin help" >&2
    exit 2
    ;;
esac
