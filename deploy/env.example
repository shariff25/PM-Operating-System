# PM OS on its host: deploy/.env. Made by deploy/setup.sh from this file; never commit it.
# setup.sh fills in every `generated` value. You fill in the values marked `you`.
# Keep a copy of the finished file in the team password manager: PMOS_VAULT_KEY is the only
# way to read the stored Atlassian, Slack and GitHub tokens.

# --- Paths (setup.sh asks) ---
# The git checkout of the content repo (default /srv/pmos/content-repo). The tool server pulls
# it; the other services read it.
PMOS_CONTENT_CHECKOUT=
# The checkout's read-only deploy key, for `git pull` (optional; blank for a public repo).
PMOS_CONTENT_DEPLOY_KEY=
# Audit, usage and Slack state (default /srv/pmos/state).
PMOS_STATE_DIR=
# The user and group that own the checkout and the state directory (setup.sh sets these).
PMOS_UID=
PMOS_GID=

# --- Mode (you) ---
# `fake` for the first bring-up (fixture Jira, Confluence and Slack); `live` at Gate 1, with
# deploy/live.env filled in.
PMOS_CONNECTORS=fake
# 1 until the model servers are up (`pmos-admin up --models`): the gateway answers with a stub.
PMOS_GATEWAY_STUB=1
PMOS_DEFAULT_TZ=America/Los_Angeles

# --- Improvement loop (docs/runbooks/quality.md) ---
# When each bot's quality owner gets the day's rejected and heavily edited drafts (`off` to stop).
PMOS_TRIAGE_AT=09:00
# How much a PM must have changed a draft for it to count as heavily edited (0–1).
PMOS_TRIAGE_MIN_EDIT=0.3
# A draft nobody decides in this many days counts as expired in the ledger.
PMOS_LEDGER_EXPIRE_DAYS=7
# An approval of an unchanged draft within this many seconds counts as fast in the ledger
# summary: a tripwire for rubber-stamping, never a target (docs/runbooks/quality.md).
PMOS_LEDGER_FAST_APPROVAL_SECONDS=5

# --- Audit retention (docs/audit-retention.md) ---
# The tool server deletes audit events older than this many days, once a day, with no archive.
# 90 is the minimum (the owner's decision; the database itself refuses less) and the default;
# a larger number keeps events longer, up to 3650. A value under 90 stops the tool server at
# start-up. `deploy/pmos-admin audit purge --dry-run` shows what the next run would delete.
# The JSON-lines copy in $PMOS_STATE_DIR/audit is not purged by PM OS.
PMOS_AUDIT_RETENTION_DAYS=90

# --- Your docs site (you): docs/docs-server.md, "Pointing the Docs bot at your docs" ---
# The public docs site the Docs bot answers from (https://, no trailing slash), such as
# https://docs.example.com. It must publish /llms.txt and a markdown (.md) version of each
# page. Leave blank to start without one: the docs index stays empty and the Docs bot says no
# docs site is configured.
PMOS_DOCS_BASE_URL=
# How the bots and Slack name the site, such as "the Acme Help Center". Keep the quotes:
# pmos-admin reads this file as a shell script.
PMOS_DOCS_NAME="the public docs"
# Comma-separated URL path prefixes whose pages are indexed, such as /docs/,/apidocs/.
PMOS_DOCS_PAGE_PREFIXES=/
# A path prefix whose pages are API reference (section `api`), such as /apidocs/. Optional.
PMOS_DOCS_API_PREFIX=
# Product ids for filtering docs search: a YAML file in this repo's config/ folder, given as
# the path the docs service sees, /etc/pmos/config/<file>. Start from
# config/docs-products.example.yaml: copy it to config/docs-products.yaml, edit it, and set
# /etc/pmos/config/docs-products.yaml. Blank: every page is product `general`.
PMOS_DOCS_PRODUCTS=
# The benchmarks use fake docs fixtures. To benchmark your own docs site, set this to
# http://docs.pmos.internal:8730/mcp (docs/evals.md, "The eval stack").
PMOS_EVAL_DOCS_URL=

# --- Slack app (you): docs/slack-app-manifest.yaml, then the app's pages ---
PMOS_SLACK_BOT_TOKEN=
PMOS_SLACK_APP_TOKEN=
PMOS_GITHUB_ORG=

# --- Console (you, optional; docs/console.md, "Sign-in") ---
# The console runs only behind a reverse proxy on this machine that signs people in, strips any
# X-Forwarded-User and X-Pmos-Proxy-Secret from the browser's request, and sets both itself:
# the user, and PMOS_CONSOLE_PROXY_SECRET (generated below). Set TRUST_PROXY=1 for that.
# PMOS_CONSOLE_DEV_USER is for running the console on your own machine (a loopback bind); the
# container listens on 0.0.0.0, so the console refuses it here. Leave it blank.
PMOS_CONSOLE_DEV_USER=
# With 1, the console believes X-Forwarded-User only on requests that also carry
# X-Pmos-Proxy-Secret equal to PMOS_CONSOLE_PROXY_SECRET, and refuses to start without that
# secret. Put the same value in the proxy's config (docs/runbooks/install.md).
PMOS_CONSOLE_TRUST_PROXY=0
PMOS_CONSOLE_PUBLIC_URL=
PMOS_CONSOLE_SLACK_URL=

# --- Web app (you, optional; OFF by default; docs/web-app-running.md) ---
# The web app's https:// address (origin only), for the browser's Origin check, Entra's redirect
# URI and the Slack bot's "Open in workspace" button. Blank: no button; Origin must match Host.
PMOS_WEB_PUBLIC_URL=
# Entra ID sign-in (docs/entra-sign-in.md, "What to register in Entra"). `pmos-admin up --web`
# starts the web app with these three and PMOS_WEB_PUBLIC_URL all set; some but not all and the
# web app refuses to start. The tenant and client ids are GUIDs from the app registration's
# overview (not `common` or `organizations`). The client secret comes from the registration's
# "Certificates & secrets": paste it here, keep it in the team password manager, and note its
# expiry (sign-in stops when it lapses). Blank: off. The tool server gets the tenant id, the
# client id and the authority too (never the secret), as PMOS_ENTRA_*: it validates the ID token
# of a first Microsoft sign-in itself, so it doesn't take the web app's word for who that is.
PMOS_WEB_ENTRA_TENANT_ID=
PMOS_WEB_ENTRA_CLIENT_ID=
PMOS_WEB_ENTRA_CLIENT_SECRET=
# Only for a sovereign cloud: its login origin. Blank: https://login.microsoftonline.com.
PMOS_WEB_ENTRA_AUTHORITY=
# Password sign-in (docs/password-sign-in.md): a sign-in name and password, then always a code
# from an authenticator app. 1 turns it on, beside Entra or on its own; `pmos-admin up --web`
# starts the web app with it. People get a password with a one-time setup code an admin makes on
# the Team page (an Admin's or Auditor's: `pmos-admin users password-setup <handle>`). Needs
# PMOS_ASSERTION_MODE=require (setup.sh writes it) and PMOS_WEB_PUBLIC_URL set to the https://
# address. Leave 0 otherwise.
PMOS_WEB_PASSWORD_LOGIN=0
# The `pmos` network's subnet and gateway, pinned so the gateway (the address a reverse proxy on
# this host reaches the web app from) never moves when the network is made again. The default
# is outside Docker's own pools. RESERVED: 10.201.77.10 to 10.201.77.14 are the tool server's,
# gateway's and runtime's and the two model servers' fixed addresses (deploy/compose.yaml; the
# bots' sandboxes reach the first three there: docs/openshell-any-host-spec.md §3.3). They are
# reviewed code, not settings, so the subnet must be a /24 or longer that holds them: a site that
# already routes 10.201.77.0/24 needs a reviewed code change (POL-2), not an edit here.
# `deploy/pmos-admin up` refuses a subnet that doesn't hold them, and a network made earlier with
# other settings than these: re-create it with deploy/pmos-admin down, then up. `up --web` also
# refuses while the network's real gateway isn't PMOS_NETWORK_GATEWAY, and says so.
PMOS_NETWORK_SUBNET=10.201.77.0/24
PMOS_NETWORK_GATEWAY=10.201.77.1
# The addresses Docker hands containers that have no fixed one (the eval stack's, a `docker run
# --network pmos_pmos`): inside the subnet and holding none of the reserved addresses above, so
# none of them can take a service's address. .2 to .127 are left for fixed addresses.
PMOS_NETWORK_IP_RANGE=10.201.77.128/25
# The ports on 127.0.0.1 the services are published on (blank: 8710, 8740, 8750, 8760, 8770).
# Change them when another stack on this host already listens there; pmos-admin's status, smoke
# and other calls follow them. A reverse proxy in front of the web app forwards to PMOS_WEB_PORT.
PMOS_TOOLSERVER_PORT=
PMOS_GATEWAY_PORT=
PMOS_BOTS_PORT=
PMOS_CONSOLE_PORT=
PMOS_WEB_PORT=
# The sandbox-audit collector's port on 127.0.0.1 (blank: 8780), where OpenShell's OTLP log
# export posts (docs/openshell-prover-and-sandbox-audit-spec.md Part B). Off unless configured:
# `deploy/pmos-admin sandbox-audit configure` writes PMOS_SANDBOX_AUDIT_TOKEN (the collector's
# own, append-only tool-server token; blank: the tool server's collector routes answer 404) and
# prints OpenShell's settings; `check` verifies them; `up` starts it.
PMOS_SANDBOX_AUDIT_PORT=
PMOS_SANDBOX_AUDIT_TOKEN=
# OpenShell's gateway configuration, for `sandbox-audit check` (blank: ~/.config/openshell/
# gateway.toml; verify the path on the host).
PMOS_OPENSHELL_GATEWAY_TOML=
# The pinned OpenShell policy prover on this host, for `deploy/pmos-admin policy prove` (blank:
# openshell-prover on PATH). Its SHA-256 and version must be deploy/openshell-prover.lock's.
PMOS_PROVER=
# REQUIRED with password sign-in: the address(es) the reverse proxy reaches the web app from,
# comma-separated. Password sign-in limits refused attempts per browser address, read from the
# proxy's X-Forwarded-For (which the proxy must set; nginx: proxy_set_header X-Forwarded-For
# $proxy_add_x_forwarded_for); without this the web app refuses to start. A reverse proxy on this
# host reaches the web app through its published port, so it appears from the `pmos` network's
# gateway: PMOS_NETWORK_GATEWAY above. `deploy/pmos-admin up --web` refuses unless every
# address here is that gateway, printing the exact line to set. Only list proxies: an address
# here is believed about who its requests are from. Any process on this host that can connect
# to the web app's published port (127.0.0.1:8770) also arrives from the gateway and is
# believed about its X-Forwarded-For: keep untrusted software and users off this host. A
# forwarded header from any other peer is refused (403 proxy_not_trusted), counted on the web
# app's /readyz (`untrusted_proxy_refusals`, and a `warnings` entry for 15 minutes, which
# `pmos-admin status` shows), with an error in its log: a sign this setting is wrong.
PMOS_WEB_TRUSTED_PROXIES=10.201.77.1
# Set to 1 only for a reverse proxy in a container on the pmos network, listed above by its
# address inside PMOS_NETWORK_SUBNET. Docker assigns those addresses, so pin the container's
# (ipv4_address) to one in .2 to .127 that isn't reserved (10.201.77.10 to .14 are the services'
# and model servers', above); `pmos-admin up --web` warns every time it is used. Read by
# pmos-admin only.
PMOS_WEB_TRUST_PROXY_IN_NETWORK=0
# --- The admin door (slice H10, decision D3 (b); docs/runbooks/install.md, "The admin door") ---
# Every /api/admin/* route (users, content, policy, the audit log and the Auditor's views, a held
# draft's release) is served only on the web app's admin door, port 8772, with its own address,
# cookie and sign-in, for Admins and Auditors only; the browser-facing 8770 answers 404 for them
# on every host. The web app refuses to start without it.
# REQUIRED with the web app on: the admin door's own address, on a host name of its own.
#   http://<deployment>.localhost:8772  (the tunnel mode: an SSH tunnel to the loopback publish,
#                                        ssh -L 8772:127.0.0.1:8772 <host>; use a name unique to
#                                        this deployment, never a bare localhost, which every
#                                        local page shares)
#   https://pmos-admin.corp.example     (the proxy mode: a TLS terminator on a private address,
#                                        with PMOS_WEB_ADMIN_TRUSTED_PROXIES)
PMOS_WEB_ADMIN_URL=
# Where 8772 is published on this host: loopback (the default, and the only choice for an http
# admin URL) or an RFC 1918 or 100.64.0.0/10 address, never a public one. IPv4 only.
PMOS_WEB_ADMIN_PUBLISH=127.0.0.1
# The proxy mode only: the address the TLS terminator reaches the web app from (a terminator on
# this host: the pmos network's gateway, PMOS_NETWORK_GATEWAY). Blank in the tunnel mode, where the
# one peer taken is that gateway and X-Forwarded-For is never read.
PMOS_WEB_ADMIN_TRUSTED_PROXIES=
# Admin sessions: idle (default 30, at most 60) and absolute (default 480, at most 720) minutes.
PMOS_WEB_ADMIN_SESSION_IDLE_MINUTES=
PMOS_WEB_ADMIN_SESSION_MAX_MINUTES=
# 1 only after <PMOS_WEB_ADMIN_URL>/api/auth/callback is added as a second redirect URI of the
# Entra app registration: Microsoft sign-in on the admin door. 0 (the default): the admin door is
# password-only (an open question for the owner, spec §8.2 item 9).
PMOS_WEB_ADMIN_ENTRA=0
# Decision D2 (a): the networks password sign-in is served to, comma-separated CIDRs (a VPN's or
# an office's ranges), each no wider than a /16 (IPv4) or a /48 (IPv6). REQUIRED with
# PMOS_EXPOSURE=public and password sign-in on; optional on private. Any password request from
# outside it answers 403 password_sign_in_not_from_here; Microsoft sign-in is unaffected.
PMOS_WEB_PASSWORD_CLIENTS=
# Where the web app keeps sessions, settings and follow-ups. Blank: in memory, so a restart signs
# everyone out. To keep them, use the kit's Postgres with a database and role of the web app's
# own, like the other services. postgres-init.sh only runs when the volume is first made, so
# create them once by hand, with a fresh password. The password goes to psql on its standard
# input (printf is a shell builtin), never with -c on a command line, where every account on
# this machine could read it:
#   deploy/pmos-admin up    # Postgres running
#   pw=$(openssl rand -hex 16)
#   printf "CREATE ROLE pmos_web LOGIN PASSWORD '%s';\nCREATE DATABASE pmos_web OWNER pmos_web;\nREVOKE ALL ON DATABASE pmos_web FROM PUBLIC;\n" "$pw" |
#     docker compose -f deploy/compose.yaml --env-file deploy/.env exec -T postgres \
#     psql -U postgres -v ON_ERROR_STOP=1
# then set postgresql://pmos_web:<password>@postgres/pmos_web here. pmos-web makes its tables at
# start-up. `pmos-admin backup` doesn't dump this database.
PMOS_WEB_DATABASE_URL=
# Development sign-in, for a closed test network only: anyone who can reach the port signs in
# as any team member. `pmos-admin up --web` also starts the web app with this at 1 and no Entra
# settings. Never on a network people you don't trust can reach, and never together with Entra
# on a server people use. Leave 0 otherwise.
PMOS_WEB_ENABLE_DEV_LOGIN_CLOSED_TEST_NETWORK_ONLY=0
# The home page's daily brief panels (docs/daily-brief.md, "The web app's panels"). To turn them
# on with the web app: PMOS_WEB_BRIEF=1, and PMOS_WEB_BRIEF_URL=http://web.pmos.internal:8771 so
# the Slack service sends each PM's brief there. 8771 is the web app's internal listener
# (PMOS_WEB_INTERNAL_BIND in deploy/compose.yaml): reachable on the `pmos` network only, never
# published. The browser-facing port (8770) answers 404 for this route, so a value ending in
# :8770 sends no brief. Blank or 0: off.
PMOS_WEB_BRIEF=0
PMOS_WEB_BRIEF_URL=
# Admin policy and content proposals: the web app holds NO GitHub token (the old
# PMOS_WEB_GITHUB_* settings refuse to start; revoke that token). The tool server opens each pull
# request with the proposing admin's own linked GitHub account: the GitHub App and
# PMOS_CONTENT_REPO in deploy/live.env, and on the content branch, branch protection that
# requires someone else's review (docs/policy-admin.md, "Nobody approves their own change").

# --- Benchmarks (optional) ---
# The handles the benchmark runner's runtime token (PMOS_RT_EVALS_TOKEN) may request tasks as,
# comma-separated. Empty means `evals`, the benchmark member. List a PM's handle here only for
# as long as you run `pmos-admin evals load --as <handle>` as them (docs/evals.md), then empty
# it again: that token can then run their bots as them.
PMOS_EVALS_AS=

# --- Host settings (docs/openshell-any-host-spec.md §3.1; setup.sh writes them) ---
# Each default is the value that allows less; the values that allow more must be chosen, and are
# checked. Every service that enforces one gets it from deploy/compose.yaml, so its refusals hold
# however the stack is started; blank is refused, never read as another value.
#
# PMOS_MODEL_SOURCE: where prompts go (§3.6). `hosted-test` (setup.sh's default): TESTING ONLY,
# every role on a hosted OpenAI-compatible model nobody approved, so prompts leave this host and
# the stack takes FAKE DATA ONLY: the tool server, the runtime, the web app and the Slack bot each
# refuse what could bring real data in (live connectors, GitHub memory, content without a
# TEST-CONTENT marker or with a file marked restricted, a database that has held real data,
# Slack tokens), and the gateway takes only a `class: test` config, which pmos-admin writes to
# $PMOS_STATE_DIR/gateway.hosted-test.yaml (deploy/compose.hosted-test.yaml). `local`: the vLLM
# servers below (an NVIDIA GPU and PMOS_VLLM_IMAGE) behind deploy/gateway.yaml (`class:
# production`); real data after Gate 1. `hosted` (an approved provider) isn't built yet (slice
# H12), and every service refuses it.
PMOS_MODEL_SOURCE=
# PMOS_EXPOSURE: who can reach the sign-in page (§3.8). `public` (setup.sh's default): the host has
# a public address or sits on a network you don't control; the web app then takes Microsoft
# sign-in from anywhere and password sign-in only from PMOS_WEB_PASSWORD_CLIENTS, never
# development sign-in (decision D2 (a)). `private`: reached only from a network the company
# controls (H-PRIVATE checks it; the web app refuses it while PMOS_WEB_PUBLIC_URL resolves to a
# public address).
PMOS_EXPOSURE=
# The OpenShell compute driver: only `docker` (Tier 1).
PMOS_OPENSHELL_DRIVER=
# hosted-test only: the provider's OpenAI-compatible base URL (https://), the model id, and the
# neutral label the gateway reports and logs instead of the model id (docs/gateway.md, "Hiding
# the model behind a label"). None of these goes into a committed file.
PMOS_HOSTED_TEST_URL=
PMOS_HOSTED_TEST_MODEL=
PMOS_HOSTED_TEST_LABEL=hosted-model-a
# hosted-test only: the provider's key (sent as Authorization: Bearer; never logged), or, behind
# an egress proxy that injects the key, the placeholder that proxy replaces.
PMOS_GATEWAY_REMOTE_KEY=
# hosted-test only: the CA bundle a proxy that re-signs TLS needs at run time, as an absolute
# path on this host (deploy/compose.gateway-ca.yaml mounts it into the gateway only). The whole
# bundle: the gateway then trusts only what is in it. Refused with `local`.
PMOS_GATEWAY_CA_FILE=
# hosted-test only, model routes (docs/model-providers-spec.md, docs/gateway.md "Routes"): 1 to
# use the route config you write at $PMOS_STATE_DIR/gateway.hosted-test.yaml (several upstreams,
# each key from `deploy/pmos-admin upstream-key set <u>`) in place of the one-upstream settings
# above, which must then be blank. `up` checks it with the gateway first.
PMOS_HOSTED_TEST_ROUTES=0
# The gateway's read-only admin client, for `deploy/pmos-admin routes` (openssl rand -hex 24);
# blank: no admin client.
PMOS_GW_ADMIN_TOKEN=
# A benchmarked bot answered by a fallback model: `mark` (the answer says so; the default) or
# `refuse` (its calls keep to each role's primary, and fail as "the model is busy" instead).
PMOS_FALLBACK_FOR_BENCHMARKED=mark

# --- Models (PMOS_MODEL_SOURCE=local only) ---
# The vLLM image for this host's architecture and GPU, pinned by tag, never `latest` (no
# default, slice H4): for example NVIDIA's build (nvcr.io/nvidia/vllm:<tag>) or the vLLM
# project's own image, each designed for and not yet verified (decision O3). Required with `local`
# once PMOS_GATEWAY_STUB is 0 (deploy/compose.local.yaml); H-NVIDIA checks it.
PMOS_VLLM_IMAGE=
PMOS_MODEL_DEFAULT=Qwen/Qwen3.6-35B-A3B
PMOS_MODEL_DEFAULT_GPU_SHARE=0.55
PMOS_MODEL_EXTRACTION=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
PMOS_MODEL_EXTRACTION_GPU_SHARE=0.30
# A Hugging Face read token, if a model needs one to download.
HF_TOKEN=

# --- Network (you, if the host has an outbound proxy) ---
HTTPS_PROXY=
NO_PROXY=
# The proxy's CA certificate file, if it re-signs TLS (used only to build the images).
PMOS_BUILD_CA=

# --- User assertions (docs/user-assertion.md, Modes) ---
# How the runtime and the tool server treat user assertions from the web app and the console.
# `require` (what setup.sh writes here, and what blank means once a web or console token is
# set): a call that names a person needs a valid one. Kept in this file, so every
# `pmos-admin up`, `add-bot` and the `up` after a `restore` start the services the same way.
# `off` or `verify` with a web or console token set makes the runtime and the tool server
# REFUSE TO START, and `pmos-admin` refuses before it starts anything. There is no override
# for this deployment: the development one (PMOS_ASSERTION_INSECURE_OFF) is for fake-data
# development stacks only, compose.yaml doesn't pass it, and the services refuse it with live
# connectors or a database (docs/user-assertion.md, Modes).
PMOS_ASSERTION_MODE=require

# --- Slack features (docs/onboarding-spec.md, docs/nudges.md) ---
# The first-time flow for a new member in Slack: 1 on (the default here), 0 off.
PMOS_ONBOARDING_V2=1
# Gentle nudges in Slack (docs/nudges.md): 1 on (the default here), 0 off. They are sent only
# within PMOS_NUDGES_HOURS in each PM's time zone (blank: 09:00-17:00).
PMOS_NUDGES=1
PMOS_NUDGES_HOURS=

# --- Secrets between the services (generated; don't edit) ---
PMOS_POSTGRES_PASSWORD=generated
PMOS_DB_TOOLSERVER_PASSWORD=generated
PMOS_DB_BOTS_PASSWORD=generated
PMOS_DB_DOCS_PASSWORD=generated
PMOS_SERVICE_TOKEN=generated
PMOS_BOT_TOKEN=generated
PMOS_DOCS_TOKEN=generated
PMOS_VAULT_KEY=generated
PMOS_GW_RUNTIME_TOKEN=generated
PMOS_GW_EVALS_TOKEN=generated
PMOS_GW_DOCS_BOT_TOKEN=generated
PMOS_RT_SLACK_TOKEN=generated
PMOS_RT_CONSOLE_TOKEN=generated
PMOS_RT_WEB_TOKEN=generated
PMOS_RT_EVALS_TOKEN=generated
PMOS_RT_DOCS_WORKER_TOKEN=generated
# The web app's own tool server token (the approvals routes and the read-only admin routes).
PMOS_TS_WEB_TOKEN=generated
# The console's own tool-server token: it may only read approvals.
PMOS_CONSOLE_TS_TOKEN=generated
# User assertion keys, one per caller and receiver (docs/user-assertion.md): `<key id>:<base64>`,
# or `<new id>:<new base64>:<old id>:<old base64>` while rotating. Each service gets only its own.
PMOS_AK_WEB_BOTS=generated
PMOS_AK_WEB_TOOLSERVER=generated
PMOS_AK_CONSOLE_BOTS=generated
PMOS_AK_CONSOLE_TOOLSERVER=generated
# The Slack service sends each daily brief to the web app with this (PUT /internal/brief/…).
PMOS_WEB_BRIEF_TOKEN=generated
# The reverse proxy sends this in X-Pmos-Proxy-Secret on every request to the console; without
# it the console ignores X-Forwarded-User. Required with PMOS_CONSOLE_TRUST_PROXY=1.
PMOS_CONSOLE_PROXY_SECRET=generated
# One entry per bot sandbox beyond the Docs bot, added by `pmos-admin add-bot <bot>`.
PMOS_GW_BOT_TOKENS=
PMOS_RT_WORKER_TOKENS=
# Bring-up only, fake data only: one PM's personal bot (pm-<handle>, after `pmos-admin add-bot`)
# run as a plain, NOT isolated container by `pmos-admin up --bringup`, on a host without
# OpenShell (deploy/compose.yaml, worker-personal). Blank: none.
PMOS_BRINGUP_PERSONAL_BOT=
