# PM OS on the Spark: deploy/.env. Made by deploy/setup.sh from this file; never commit it.
# setup.sh fills in every `generated` value. You fill in the values marked `you`.
# Keep a copy of the finished file in the team password manager: PMOS_VAULT_KEY is the only
# way to read the stored Atlassian, Slack and GitHub tokens.

# --- Paths (setup.sh asks) ---
# The git checkout of the content repo (default /srv/pmos/content-repo). The tool server pulls
# it; the other services read it.
PMOS_CONTENT_CHECKOUT=
# The checkout's read-only deploy key, for `git pull` (optional; blank for a public repo).
PMOS_CONTENT_DEPLOY_KEY=
# Audit, usage and Slack state (default /srv/pmos/state).
PMOS_STATE_DIR=
# The user and group that own the checkout and the state directory (setup.sh sets these).
PMOS_UID=
PMOS_GID=

# --- Mode (you) ---
# `fake` for the first bring-up (fixture Jira, Confluence and Slack); `live` at Gate 1, with
# deploy/live.env filled in.
PMOS_CONNECTORS=fake
# 1 until the model servers are up (`pmos-admin up --models`): the gateway answers with a stub.
PMOS_GATEWAY_STUB=1
PMOS_DEFAULT_TZ=America/Los_Angeles

# --- Improvement loop (docs/runbooks/quality.md) ---
# When each bot's quality owner gets the day's rejected and heavily edited drafts (`off` to stop).
PMOS_TRIAGE_AT=09:00
# How much a PM must have changed a draft for it to count as heavily edited (0–1).
PMOS_TRIAGE_MIN_EDIT=0.3
# A draft nobody decides in this many days counts as expired in the ledger.
PMOS_LEDGER_EXPIRE_DAYS=7

# --- Your docs site (you): docs/docs-server.md, "Pointing the Docs bot at your docs" ---
# The public docs site the Docs bot answers from (https://, no trailing slash), such as
# https://docs.example.com. It must publish /llms.txt and a markdown (.md) version of each
# page. Leave blank to start without one: the docs index stays empty and the Docs bot says no
# docs site is configured.
PMOS_DOCS_BASE_URL=
# How the bots and Slack name the site, such as "the Acme Help Center".
PMOS_DOCS_NAME=the public docs
# Comma-separated URL path prefixes whose pages are indexed, such as /docs/,/apidocs/.
PMOS_DOCS_PAGE_PREFIXES=/
# A path prefix whose pages are API reference (section `api`), such as /apidocs/. Optional.
PMOS_DOCS_API_PREFIX=
# Product ids for filtering docs search: a YAML file in this repo's config/ folder, given as
# the path the docs service sees, /etc/pmos/config/<file>. Start from
# config/docs-products.example.yaml: copy it to config/docs-products.yaml, edit it, and set
# /etc/pmos/config/docs-products.yaml. Blank: every page is product `general`.
PMOS_DOCS_PRODUCTS=
# The benchmarks use fake docs fixtures. To benchmark your own docs site, set this to
# http://docs.pmos.internal:8730/mcp (docs/evals.md, "The eval stack").
PMOS_EVAL_DOCS_URL=

# --- Slack app (you): docs/slack-app-manifest.yaml, then the app's pages ---
PMOS_SLACK_BOT_TOKEN=
PMOS_SLACK_APP_TOKEN=
PMOS_GITHUB_ORG=

# --- Console (you, optional) ---
# Before SSO: one platform owner's handle, reached over an SSH tunnel. With SSO: TRUST_PROXY=1.
PMOS_CONSOLE_DEV_USER=
PMOS_CONSOLE_TRUST_PROXY=0
PMOS_CONSOLE_PUBLIC_URL=
PMOS_CONSOLE_SLACK_URL=

# --- Models (verify on the Spark) ---
PMOS_VLLM_IMAGE=nvcr.io/nvidia/vllm:25.10-py3
PMOS_MODEL_DEFAULT=Qwen/Qwen3.6-35B-A3B
PMOS_MODEL_DEFAULT_GPU_SHARE=0.55
PMOS_MODEL_EXTRACTION=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
PMOS_MODEL_EXTRACTION_GPU_SHARE=0.30
# A Hugging Face read token, if a model needs one to download.
HF_TOKEN=

# --- Network (you, if the Spark has an outbound proxy) ---
HTTPS_PROXY=
NO_PROXY=
# The proxy's CA certificate file, if it re-signs TLS (used only to build the images).
PMOS_BUILD_CA=

# --- Secrets between the services (generated; don't edit) ---
PMOS_POSTGRES_PASSWORD=generated
PMOS_DB_TOOLSERVER_PASSWORD=generated
PMOS_DB_BOTS_PASSWORD=generated
PMOS_DB_DOCS_PASSWORD=generated
PMOS_SERVICE_TOKEN=generated
PMOS_BOT_TOKEN=generated
PMOS_DOCS_TOKEN=generated
PMOS_VAULT_KEY=generated
PMOS_GW_RUNTIME_TOKEN=generated
PMOS_GW_EVALS_TOKEN=generated
PMOS_GW_DOCS_BOT_TOKEN=generated
PMOS_RT_SLACK_TOKEN=generated
PMOS_RT_CONSOLE_TOKEN=generated
PMOS_RT_EVALS_TOKEN=generated
PMOS_RT_DOCS_WORKER_TOKEN=generated
# One entry per bot sandbox beyond the Docs bot, added by `pmos-admin add-bot <bot>`.
PMOS_GW_BOT_TOKENS=
PMOS_RT_WORKER_TOKENS=
